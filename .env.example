# Plantilla de variables de entorno — copia este archivo a `.env`
# (el `.env` real NO se sube a git) y rellena los dos valores con las
# credenciales reales del proyecto de Supabase compartido con la app de
# Copermiq (app.copermiq.com). Ver comentarios en src/lib/supabaseClient.js
# para más contexto, y para dónde configurar estas mismas variables en
# Netlify de cara a producción.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Measurement ID de la propiedad de Google Analytics 4 (formato G-XXXXXXXXXX).
# Se usa en src/components/CookieConsent.astro. Si se deja vacío, no se
# renderiza ni el banner de cookies ni el script de Analytics — así que en
# local (sin rellenar esto) la web funciona igual, simplemente sin analítica.
PUBLIC_GA_MEASUREMENT_ID=

# Site key de Cloudflare Turnstile (2026-08-21) — ver el comentario largo al
# principio de src/components/AuthModal.astro para el contexto completo.
# Reutiliza el MISMO site key que ya usa la app (0x4AAAAAAEXdHW6UM2BzY75G),
# pero antes hay que añadir copermiq.com (y probablemente www.copermiq.com)
# a la lista de hostnames permitidos de ESE widget en el panel de Cloudflare
# — si no, Cloudflare lo rechazará por dominio no autorizado aunque la clave
# esté bien puesta aquí. Sin esta variable, el formulario de /cuenta se
# deshabilita con un aviso en vez de fallar en seco — y desde que se activó
# "Attack Protection" en Supabase (proyecto compartido con la app), el
# login/alta/recuperación de esta web NO funcionan sin ella.
PUBLIC_TURNSTILE_SITE_KEY=
