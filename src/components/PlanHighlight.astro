---
// Banda de plan (Pro o Premium), justo después de Funciones (que ahora
// explica también Basic, antes "Gratis" — ver Pricing.astro) — a
// petición de Miq del 2026-08-22, a partir de las páginas 2 y 3 de su PDF
// de mockups: "Estas 3 secciones deben ir seguidas pues te muestran los 3
// planes desde el gratis hasta el premium." (Reorden 2026-08-31: ya no va
// seguido de Vista previa, que sube a justo después de HeroCta — ver
// index.astro). Fondos NO
// inventados: gris #C7CDD6 para Pro y dorado #D9B45C para Premium son los
// mismos tokens que ya usa .admin-plan-select--suscripcion/--premium en el
// panel de admin (ver global.css) — Miq pidió "el color de la etiqueta del
// plan Pro" y un dorado "a ver como queda" en vez del navy/verde del PDF.
//
// Las funciones listadas salen de PlanComparison.astro (la fuente
// verificada de qué trae cada plan), no son una lista nueva inventada:
// - Pro: las que en esa tabla pasan de DASH (Basic) a CHECK (Pro).
// - Premium: las que solo tiene Premium (DASH también en Pro).
// Precios (1,95 €/mes y 8,95 €/mes) tomados de Pricing.astro.
//
// Corrección 2026-08-22 (mismo día): la primera entrega inventó los
// mockups de la derecha (un interruptor turquesa + campos que no existen,
// y cifras/campos distintos en el panel de Premium) en vez de ceñirse a
// las capturas reales que pasó Miq. Aviso explícito de Miq: "debes
// ceñirte a la gráfica que te proporciono, si no te lo pido expresamente
// [...] no puedes inventarte graficas porque estamos intentando vender
// bien el producto". Reconstruido pixel a pixel sobre el PDF real (ver
// comentarios en el marcado de abajo) — los botones de acción también
// pasan a navy sólido, no turquesa ("los botones color turquesa no
// existen, de momento, en la app"). La rejilla de funciones (features)
// también pasa de lista vertical a 2 columnas, tal cual la captura.
//
// Mockup de Pro (página 2 del PDF): checkbox "Esta factura es periódica"
// + 2 desplegables (Frecuencia/Cliente) — sin barra de título, sin
// interruptor y sin campo "Próxima emisión" (ninguno de los 3 estaba en
// la captura real).
// Mockup de Premium (página 3): desglose Base imponible / Cuota IVA
// repercutida / Retenciones IRPF + total en negrita, botones Excel/CSV
// (contorno) + PDF (navy sólido) — antes tenía campos y cifras
// inventados ("Periodo", "Facturas incluidas", "Base + IVA" combinados).
//
// Corrección 2026-08-22 (misma tarde) — de franja a cápsula: Miq pidió
// "que las secciones premium y pro no fuesen 100% ancho, que esten dentro
// de una capsula como la de empieza hoy, pero con sus colores". Antes el
// fondo de color vivía en el propio `<section>` (franja a todo el ancho
// del viewport, mismo patrón que tenía `Security.astro` antes del 21/08).
// Ahora vive en un nuevo `.plan-highlight-card` dentro del `.wrap` de
// siempre (1140px máx.) — mismo `border-radius`/`box-shadow` que ya usa
// `.final-cta .card` ("Empieza hoy"), así que visualmente es la misma
// familia de cápsula. Los colores en sí no cambiaron, solo dónde se
// pintan: antes `.plan-highlight-pro`/`.plan-highlight-premium` coloreaban
// el `<section>` entero, ahora colorean `.plan-highlight-card` (ver
// `global.css`, selectores `.plan-highlight-pro .plan-highlight-card` /
// `.plan-highlight-premium .plan-highlight-card`).

interface Props {
  plan: 'pro' | 'premium';
}

const { plan } = Astro.props;

const CHECK_ICON_PATH = 'M4 10.5L8 14.5L16 6';

const content = {
  pro: {
    pill: 'Plan Pro · 1,95 €/mes',
    heading: 'Con Pro, además…',
    description:
      'Cuando tu actividad crece, Pro añade automatizaciones y un punto más profesional a cada factura — sin dejar de ser sencillo.',
    features: [
      'Facturas periódicas / recurrentes',
      'PDF sin pie de marca "generado con Copermiq"',
      'Categorías de gasto personalizables',
      'Copia de seguridad automática (por email)',
    ],
  },
  premium: {
    pill: 'Plan Premium · 8,95 €/mes',
    heading: 'Con Premium, todo eso y más',
    description:
      'Para quien quiere ir un paso más allá: libros registro listos para tu gestor, personalización completa y soporte prioritario.',
    features: [
      'Libros registro (facturas emitidas y recibidas)',
      { text: 'Escáner de gasto con IA (rellena el gasto con foto)', badge: 'En proceso' },
      'Gestor avanzado de clientes (ERP)',
      'Colores de marca personalizables',
      'Copias de seguridad en la nube de Google Drive',
      'Soporte prioritario',
    ],
  },
}[plan];
---

<section class:list={['plan-highlight', plan === 'pro' ? 'plan-highlight-pro' : 'plan-highlight-premium']}>
  <div class="wrap">
    <div class="plan-highlight-card plan-highlight-inner">
    <div class="plan-highlight-copy">
      <span class="plan-highlight-pill">{content.pill}</span>
      <h2>{content.heading}</h2>
      <p>{content.description}</p>
      <ul class="plan-highlight-list">
        {content.features.map((f) => {
          const feature = typeof f === 'string' ? { text: f, badge: null } : f;
          return (
            <li>
              <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d={CHECK_ICON_PATH} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>
                {feature.text}
                {feature.badge && <span class="pc-badge-soon">{feature.badge}</span>}
              </span>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="plan-highlight-visual">
      {plan === 'pro' ? (
        <div class="ph-mock">
          <div class="ph-checkbox-row">
            <span class="ph-checkbox">
              <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="ph-checkbox-label">Esta factura es periódica (recordarme la siguiente)</span>
          </div>
          <div class="ph-fields-row">
            <div class="ph-field">
              <span class="ph-field-label">Frecuencia</span>
              <span class="ph-field-select">
                <span>Mensual</span>
                <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
            <div class="ph-field">
              <span class="ph-field-label">Cliente</span>
              <span class="ph-field-select">
                <span>Estudio Marín</span>
                <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </div>
        </div>
      ) : (
        <div class="ph-mock">
          <div class="ph-mock-title">Libro registro — Facturas emitidas</div>
          <div class="ph-mock-line"><span>Base imponible</span><span>4.180,00 €</span></div>
          <div class="ph-mock-line"><span>Cuota IVA repercutida</span><span>877,80 €</span></div>
          <div class="ph-mock-line"><span>Retenciones IRPF</span><span>627,00 €</span></div>
          <hr class="ph-mock-divider" />
          <div class="ph-mock-total"><span>Total facturado</span><span>4.430,80 €</span></div>
          <div class="ph-mock-actions">
            <span class="ph-mock-btn">↓ Excel/CSV</span>
            <span class="ph-mock-btn ph-mock-btn-primary">↓ PDF</span>
          </div>
        </div>
      )}
    </div>
    </div>
  </div>
</section>
