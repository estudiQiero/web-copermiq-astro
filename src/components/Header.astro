---
---

<header class="site-header">
  <div class="wrap">
    <a href="/" class="brand">
      <img src="/images/copernico-mark.webp" alt="Copermiq" />
      <span class="brand-name">Copermiq</span>
    </a>

    <div class="header-actions">
      <!-- 2026-08-28 (Miq): "el interruptor de cerrar sesión, dentro de la
           pastilla de usuario" — el botón de cerrar sesión pasa de ir suelto
           al lado del icono de cuenta a compartir la misma píldora con él.
           Van en un wrapper aparte (en vez de anidar un <button> dentro de
           otro <button>, que no es válido en HTML) — el fondo de píldora
           vive ahora en este div, no en #account-toggle (ver
           .account-pill/.account-btn en global.css). -->
      <div id="account-pill" class="account-pill">
        <button id="account-toggle" class="icon-btn account-btn" type="button" aria-label="Cuenta" aria-haspopup="dialog" aria-controls="auth-overlay">
          <span class="account-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.8"/>
              <path d="M4.5 19.5c1.6-3.8 4.7-5.8 7.5-5.8s5.9 2 7.5 5.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span class="status-dot" aria-hidden="true"></span>
          </span>
          <span id="account-username" class="account-username"></span>
        </button>

        <!-- Icono típico de "power" (semicírculo abierto arriba + rayita
             que lo corta), blanco sobre círculo granate — mismo tono que el
             resto de acciones destructivas del sitio (var(--stamp-red)).
             Solo tiene sentido con sesión iniciada, así que empieza oculto
             (ver AuthModal.astro, que lo muestra/oculta según el estado de
             la sesión). -->
        <button id="header-logout-btn" class="logout-icon-btn" type="button" aria-label="Cerrar sesión" hidden>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 4v7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M7 6.3a7 7 0 1 0 10 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <button class="icon-btn" type="button" aria-label="Carrito">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3.5 4.5h2l1.6 9.7a2 2 0 002 1.65h7.9a2 2 0 001.97-1.63L20.5 8H6.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9.7" cy="19.7" r="1.3" fill="currentColor"/>
          <circle cx="16.6" cy="19.7" r="1.3" fill="currentColor"/>
        </svg>
      </button>

      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="site-menu">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>
    </div>
  </div>

  <!-- Prueba 2026-08-20: en vez de panel lateral, el menú se despliega
       horizontal justo debajo de la cabecera, integrado con ella (mismo
       fondo, sin hueco) y SIN empujar el contenido de la página —
       `position:absolute` respecto a `.site-header` (que ya es
       `position:sticky`, así que hace de referencia) en vez de ocupar
       espacio en el flujo normal. La cabecera sigue siendo sticky y el
       icono de hamburguesa queda siempre visible y hace de abrir/cerrar
       (su propia animación de cruz), así que ya no hace falta un botón de
       cerrar aparte ni un fondo oscurecido tapando la página — solo la
       sombra debajo del propio desplegable. -->
  <nav id="site-menu" class="site-menu" aria-hidden="true">
    <div class="wrap">
      <ul class="menu-nav-list">
        <!-- 2026-08-28 (Miq): con sesión iniciada, este menú deja de ser el
             menú de marketing (Funciones, Precios…) — no aporta nada
             mientras ya estás dentro de tu cuenta — y pasa a ser el acceso a
             las secciones de /cuenta: Administración (solo para el admin
             principal — ver más abajo), Cuenta y Compras. Los items de
             marketing lo siguen siendo para quien no ha iniciado sesión.
             AuthModal.astro decide qué se ve según el estado de sesión (y,
             para Administración, según profiles.is_admin). -->
        <li id="menu-item-admin" class="menu-account-item" hidden>
          <a href="/cuenta#admin">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.7"/>
              <path d="M3.5 18c1.2-3 3.4-4.6 5.5-4.6s4.3 1.6 5.5 4.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              <circle cx="17" cy="7.5" r="2.2" stroke="currentColor" stroke-width="1.7"/>
              <path d="M14.8 13.2c1.9.4 3.5 1.9 4.4 4.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
            <span>Administración</span>
          </a>
        </li>
        <li id="menu-item-cuenta" class="menu-account-item" hidden>
          <a href="/cuenta#cuenta">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.7"/>
              <path d="M4.5 19.5c1.6-3.8 4.7-5.8 7.5-5.8s5.9 2 7.5 5.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
            <span>Cuenta</span>
          </a>
        </li>
        <!-- 2026-08-28 (Miq): "un nuevo menu de preferencias... las
             preferencias de color y las de idioma", sincronizadas con lo
             que el usuario tiene elegido en la app (misma tabla
             app_config — ver src/lib/preferences.js). Visible para
             cualquier cuenta con sesión iniciada, no solo para el admin. -->
        <li id="menu-item-preferencias" class="menu-account-item" hidden>
          <a href="/cuenta#preferencias">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/>
              <path d="M12 3.5v2.4M12 18.1v2.4M20.5 12h-2.4M5.9 12H3.5M17.7 6.3l-1.7 1.7M8 16l-1.7 1.7M17.7 17.7 16 16M8 8 6.3 6.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
            <span>Preferencias</span>
          </a>
        </li>
        <li id="menu-item-compras" class="menu-account-item" hidden>
          <a href="/cuenta#compras">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M3.5 4.5h2l1.6 9.7a2 2 0 002 1.65h7.9a2 2 0 001.97-1.63L20.5 8H6.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="9.7" cy="19.7" r="1.3" fill="currentColor"/>
              <circle cx="16.6" cy="19.7" r="1.3" fill="currentColor"/>
            </svg>
            <span>Compras</span>
          </a>
        </li>
        <li class="menu-marketing-item"><a href="/#funciones">Funciones</a></li>
        <li class="menu-marketing-item"><a href="/#personalizacion">Personalización</a></li>
        <li class="menu-marketing-item"><a href="/#como-funciona">Cómo funciona</a></li>
        <li class="menu-marketing-item"><a href="/#vista-previa">Vista previa</a></li>
        <li class="menu-marketing-item"><a href="/#seguridad">Seguridad</a></li>
        <li class="menu-marketing-item"><a href="/#precios">Precios</a></li>
        <li class="menu-marketing-item"><a href="/#por-que-copermiq">Por qué Copermiq</a></li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const menuToggle = document.querySelector('.menu-toggle');
  const siteHeader = document.querySelector('.site-header');
  const siteMenu = document.querySelector('#site-menu');

  function closeMenu() {
    siteHeader?.classList.remove('menu-open');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Abrir menú');
    siteMenu?.setAttribute('aria-hidden', 'true');
  }

  function openMenu() {
    siteHeader?.classList.add('menu-open');
    menuToggle?.setAttribute('aria-expanded', 'true');
    menuToggle?.setAttribute('aria-label', 'Cerrar menú');
    siteMenu?.setAttribute('aria-hidden', 'false');
  }

  menuToggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    const isOpen = siteHeader?.classList.contains('menu-open') ?? false;
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Al elegir un enlace del menú se cierra el desplegable.
  siteMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Sin fondo oscurecido esta vez — pero un clic fuera del desplegable
  // (en el resto de la página) lo sigue cerrando, como es habitual en un
  // menú de este tipo.
  document.addEventListener('click', (event) => {
    const isOpen = siteHeader?.classList.contains('menu-open') ?? false;
    if (isOpen && siteMenu && !siteMenu.contains(event.target)) {
      closeMenu();
    }
  });

  // Logo más pequeño en cuanto hay algo de scroll (la cabecera en sí ya es
  // sticky por CSS y se queda fija arriba siempre — esto solo encoge el
  // logo una vez que ya no está en lo alto de la página). Umbral pequeño
  // (12px) para que no vaya cambiando de tamaño con cada pixel de scroll,
  // y comprobación al cargar por si la página no arranca en la posición 0
  // (p.ej. al volver atrás con el scroll ya guardado por el navegador).
  function updateScrolledState() {
    siteHeader?.classList.toggle('is-scrolled', window.scrollY > 12);
  }
  updateScrolledState();
  window.addEventListener('scroll', updateScrolledState, { passive: true });
</script>
