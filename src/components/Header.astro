---
---

<header class="site-header">
  <div class="wrap">
    <a href="/" class="brand">
      <img src="/images/copernico-mark.webp" alt="Copermiq" />
      <span class="brand-name">Copermiq</span>
    </a>

    <div class="header-actions">
      <button id="account-toggle" class="icon-btn account-btn" type="button" aria-label="Cuenta" aria-haspopup="dialog" aria-controls="auth-overlay">
        <span class="account-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.8"/>
            <path d="M4.5 19.5c1.6-3.8 4.7-5.8 7.5-5.8s5.9 2 7.5 5.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span class="status-dot" aria-hidden="true"></span>
        </span>
        <span id="account-username" class="account-username"></span>
      </button>

      <button class="icon-btn" type="button" aria-label="Carrito">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3.5 4.5h2l1.6 9.7a2 2 0 002 1.65h7.9a2 2 0 001.97-1.63L20.5 8H6.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9.7" cy="19.7" r="1.3" fill="currentColor"/>
          <circle cx="16.6" cy="19.7" r="1.3" fill="currentColor"/>
        </svg>
      </button>

      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="site-menu">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>
    </div>
  </div>

  <!-- Prueba 2026-08-20: en vez de panel lateral, el menú se despliega
       horizontal justo debajo de la cabecera, integrado con ella (mismo
       fondo, sin hueco) y SIN empujar el contenido de la página —
       `position:absolute` respecto a `.site-header` (que ya es
       `position:sticky`, así que hace de referencia) en vez de ocupar
       espacio en el flujo normal. La cabecera sigue siendo sticky y el
       icono de hamburguesa queda siempre visible y hace de abrir/cerrar
       (su propia animación de cruz), así que ya no hace falta un botón de
       cerrar aparte ni un fondo oscurecido tapando la página — solo la
       sombra debajo del propio desplegable. -->
  <nav id="site-menu" class="site-menu" aria-hidden="true">
    <div class="wrap">
      <ul class="menu-nav-list">
        <!-- Solo visible con sesión iniciada (ver AuthModal.astro, que
             quita/pone el atributo hidden según el estado de la sesión). -->
        <li id="menu-account-link" hidden><a href="/cuenta">Mi cuenta</a></li>
        <li><a href="/#funciones">Funciones</a></li>
        <li><a href="/#personalizacion">Personalización</a></li>
        <li><a href="/#como-funciona">Cómo funciona</a></li>
        <li><a href="/#vista-previa">Vista previa</a></li>
        <li><a href="/#seguridad">Seguridad</a></li>
        <li><a href="/#precios">Precios</a></li>
        <li><a href="/#por-que-copermiq">Por qué Copermiq</a></li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const menuToggle = document.querySelector('.menu-toggle');
  const siteHeader = document.querySelector('.site-header');
  const siteMenu = document.querySelector('#site-menu');

  function closeMenu() {
    siteHeader?.classList.remove('menu-open');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Abrir menú');
    siteMenu?.setAttribute('aria-hidden', 'true');
  }

  function openMenu() {
    siteHeader?.classList.add('menu-open');
    menuToggle?.setAttribute('aria-expanded', 'true');
    menuToggle?.setAttribute('aria-label', 'Cerrar menú');
    siteMenu?.setAttribute('aria-hidden', 'false');
  }

  menuToggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    const isOpen = siteHeader?.classList.contains('menu-open') ?? false;
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Al elegir un enlace del menú se cierra el desplegable.
  siteMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Sin fondo oscurecido esta vez — pero un clic fuera del desplegable
  // (en el resto de la página) lo sigue cerrando, como es habitual en un
  // menú de este tipo.
  document.addEventListener('click', (event) => {
    const isOpen = siteHeader?.classList.contains('menu-open') ?? false;
    if (isOpen && siteMenu && !siteMenu.contains(event.target)) {
      closeMenu();
    }
  });

  // Logo más pequeño en cuanto hay algo de scroll (la cabecera en sí ya es
  // sticky por CSS y se queda fija arriba siempre — esto solo encoge el
  // logo una vez que ya no está en lo alto de la página). Umbral pequeño
  // (12px) para que no vaya cambiando de tamaño con cada pixel de scroll,
  // y comprobación al cargar por si la página no arranca en la posición 0
  // (p.ej. al volver atrás con el scroll ya guardado por el navegador).
  function updateScrolledState() {
    siteHeader?.classList.toggle('is-scrolled', window.scrollY > 12);
  }
  updateScrolledState();
  window.addEventListener('scroll', updateScrolledState, { passive: true });
</script>
