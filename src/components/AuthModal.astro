---
// Modal de registro / inicio de sesión.
//
// Usa el cliente compartido de src/lib/supabaseClient.js. Al iniciar sesión
// (o registrarse, si el proyecto no exige confirmación por email) se
// redirige a /cuenta — el perfil del usuario en esta misma web.
//
// De momento esto es solo la base de autenticación: no hay todavía compra
// de plantillas ni Stripe (fase posterior).
---

<div id="auth-overlay" class="auth-overlay" hidden>
  <div class="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-title">
    <button type="button" class="auth-close" aria-label="Cerrar">
      <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Estado: sin sesión iniciada -->
    <div id="auth-signed-out">
      <div class="auth-tabs" role="tablist">
        <button type="button" class="auth-tab is-active" data-auth-tab="login" role="tab" aria-selected="true">Iniciar sesión</button>
        <button type="button" class="auth-tab" data-auth-tab="signup" role="tab" aria-selected="false">Crear cuenta</button>
      </div>

      <h3 id="auth-title" class="auth-heading">Accede a tu cuenta Copermiq</h3>

      <form id="auth-login-form" class="auth-form" data-auth-panel="login">
        <label>
          Email
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          Contraseña
          <input type="password" name="password" autocomplete="current-password" required minlength="6" />
        </label>
        <button type="submit" class="btn btn-primary auth-submit">Iniciar sesión</button>
        <button type="button" class="auth-forgot">He olvidado mi contraseña</button>
      </form>

      <form id="auth-signup-form" class="auth-form" data-auth-panel="signup" hidden>
        <label>
          Email
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          Contraseña
          <input type="password" name="password" autocomplete="new-password" required minlength="6" />
        </label>
        <button type="submit" class="btn btn-primary auth-submit">Crear cuenta</button>
      </form>

      <p id="auth-message" class="auth-message" role="alert"></p>
    </div>
  </div>
</div>

<!-- Ventana de confirmación de cierre de sesión. Antes había un botón
     "Cerrar sesión" suelto en /cuenta; ahora vive detrás del icono de
     cuenta de la cabecera (ver más abajo), para dejar libre esa pantalla
     para el panel de administración. -->
<div id="logout-overlay" class="auth-overlay" hidden>
  <div class="auth-modal logout-modal" role="dialog" aria-modal="true" aria-labelledby="logout-title">
    <button type="button" id="logout-close" class="auth-close" aria-label="Cerrar">
      <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
    <h3 id="logout-title" class="auth-heading">Cerrar sesión</h3>
    <p class="logout-text">¿Seguro que quieres cerrar tu sesión?</p>
    <div class="logout-actions">
      <button type="button" id="logout-cancel" class="btn btn-ghost">Cancelar</button>
      <button type="button" id="logout-confirm" class="btn btn-primary">Cerrar sesión</button>
    </div>
  </div>
</div>

<script>
  import { supabase, isSupabaseConfigured } from '../lib/supabaseClient.js';

  const overlay = document.getElementById('auth-overlay');
  const closeBtn = document.querySelector('#auth-overlay .auth-close');
  const accountBtn = document.getElementById('account-toggle');
  const accountUsernameEl = document.getElementById('account-username');
  const menuAccountLink = document.getElementById('menu-account-link');

  const tabs = document.querySelectorAll('.auth-tab');
  const loginForm = document.getElementById('auth-login-form');
  const signupForm = document.getElementById('auth-signup-form');
  const messageEl = document.getElementById('auth-message');

  const logoutOverlay = document.getElementById('logout-overlay');
  const logoutClose = document.getElementById('logout-close');
  const logoutCancel = document.getElementById('logout-cancel');
  const logoutConfirmBtn = document.getElementById('logout-confirm');

  function openModal() {
    if (!overlay) return;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!overlay) return;
    overlay.hidden = true;
    document.body.style.overflow = '';
  }

  function openLogoutConfirm() {
    if (!logoutOverlay) return;
    logoutOverlay.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeLogoutConfirm() {
    if (!logoutOverlay) return;
    logoutOverlay.hidden = true;
    document.body.style.overflow = '';
  }

  // Con sesión iniciada, el icono de cuenta ya no lleva directamente a
  // /cuenta (ese enlace ahora vive en el menú, como "Mi cuenta") — pregunta
  // primero si quieres cerrar sesión, que es la acción que antes era un
  // botón suelto dentro de /cuenta.
  accountBtn?.addEventListener('click', () => {
    if (accountBtn.classList.contains('is-connected')) {
      openLogoutConfirm();
      return;
    }
    openModal();
  });
  closeBtn?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', (event) => {
    if (event.target === overlay) closeModal();
  });
  logoutClose?.addEventListener('click', closeLogoutConfirm);
  logoutCancel?.addEventListener('click', closeLogoutConfirm);
  logoutOverlay?.addEventListener('click', (event) => {
    if (event.target === logoutOverlay) closeLogoutConfirm();
  });
  logoutConfirmBtn?.addEventListener('click', async () => {
    if (!supabase) return;
    logoutConfirmBtn.setAttribute('disabled', 'true');
    await supabase.auth.signOut();
    window.location.href = '/';
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (overlay && !overlay.hidden) closeModal();
    if (logoutOverlay && !logoutOverlay.hidden) closeLogoutConfirm();
  });

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');

      const target = tab.getAttribute('data-auth-tab');
      if (loginForm instanceof HTMLElement) loginForm.hidden = target !== 'login';
      if (signupForm instanceof HTMLElement) signupForm.hidden = target !== 'signup';
      setMessage('');
    });
  });

  function setMessage(text, tone) {
    if (!messageEl) return;
    messageEl.textContent = text;
    messageEl.className = 'auth-message' + (tone ? ' ' + tone : '');
  }

  // Traduce los mensajes de error de Supabase a español, para no mostrar
  // texto técnico en inglés directamente al usuario.
  function translateError(error) {
    const msg = error?.message || '';
    if (/already registered|user already exists/i.test(msg)) {
      return 'Ese email ya tiene una cuenta. Prueba a iniciar sesión.';
    }
    if (/invalid login credentials/i.test(msg)) {
      return 'Email o contraseña incorrectos.';
    }
    if (/password should be at least/i.test(msg)) {
      return 'La contraseña debe tener al menos 6 caracteres.';
    }
    if (/email not confirmed/i.test(msg)) {
      return 'Confirma tu email antes de iniciar sesión — revisa tu bandeja de entrada.';
    }
    if (/unable to validate email address|invalid email/i.test(msg)) {
      return 'Ese email no parece válido.';
    }
    return msg || 'Ha ocurrido un error. Inténtalo de nuevo.';
  }

  if (!isSupabaseConfigured) {
    setMessage(
      'Configuración pendiente: faltan las claves de Supabase (ver src/lib/supabaseClient.js).',
      'error'
    );
    loginForm?.querySelectorAll('input, button').forEach((el) => (el.disabled = true));
    signupForm?.querySelectorAll('input, button').forEach((el) => (el.disabled = true));
  }

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!supabase) return;
    setMessage('Comprobando…');
    const formData = new FormData(loginForm);
    const { data, error } = await supabase.auth.signInWithPassword({
      email: String(formData.get('email') || ''),
      password: String(formData.get('password') || ''),
    });
    if (error) {
      setMessage(translateError(error), 'error');
      return;
    }
    setMessage('');
    loginForm.reset();
    if (data.session) window.location.href = '/cuenta';
  });

  signupForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!supabase) return;
    setMessage('Creando cuenta…');
    const formData = new FormData(signupForm);
    const { data, error } = await supabase.auth.signUp({
      email: String(formData.get('email') || ''),
      password: String(formData.get('password') || ''),
    });
    if (error) {
      setMessage(translateError(error), 'error');
      return;
    }
    signupForm.reset();
    if (data.session) {
      // El proyecto no exige confirmación por email: ya hay sesión activa.
      window.location.href = '/cuenta';
      return;
    }
    setMessage('Cuenta creada. Revisa tu email para confirmarla antes de iniciar sesión.', 'success');
  });

  // Refleja el estado de sesión en el icono de cuenta de la cabecera:
  // nombre de usuario + punto verde de "conectado", y muestra/oculta el
  // enlace "Mi cuenta" del menú (solo tiene sentido con sesión iniciada).
  function renderSession(session) {
    const isSignedIn = Boolean(session?.user);
    accountBtn?.classList.toggle('is-connected', isSignedIn);
    if (accountUsernameEl) {
      accountUsernameEl.textContent = isSignedIn ? (session.user.email?.split('@')[0] ?? '') : '';
    }
    if (menuAccountLink instanceof HTMLElement) menuAccountLink.hidden = !isSignedIn;
  }

  if (supabase) {
    supabase.auth.getSession().then(({ data }) => renderSession(data.session));
    supabase.auth.onAuthStateChange((_event, session) => renderSession(session));
  }
</script>
