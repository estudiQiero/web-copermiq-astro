---
// Modal de registro / inicio de sesión.
//
// Usa el cliente compartido de src/lib/supabaseClient.js. Al iniciar sesión
// (o registrarse, si el proyecto no exige confirmación por email) se
// redirige a /cuenta — el perfil del usuario en esta misma web.
//
// De momento esto es solo la base de autenticación: no hay todavía compra
// de plantillas ni Stripe (fase posterior).
//
// ============================================================================
// 2026-08-21 — Cloudflare Turnstile (captcha), URGENTE
// ============================================================================
// El 21 de agosto se activó "Attack Protection" en Supabase Auth para el
// proyecto COMPARTIDO con la app (app.copermiq.com) — esa protección es de
// TODO el proyecto, no solo de la app, así que desde ese momento este
// formulario estaba roto en producción: cualquier login, alta o
// recuperación de contraseña fallaba con "no captcha_token found" porque
// no mandábamos ningún token. Este cambio lo arregla.
//
// Cómo funciona (confirmado por la persona que lo integró en la app,
// después de que a ellos también les diera problemas — no es una
// suposición nuestra):
// - No hace falta ninguna función de servidor propia. Supabase Auth
//   verifica el token de Turnstile de forma nativa contra Cloudflare, en
//   cuanto tiene la Secret Key configurada en su panel (Authentication →
//   Attack Protection) — cosa que ya está hecha, la hizo la app. Aquí solo
//   hace falta que el cliente (este archivo) monte el widget y mande el
//   captchaToken que genera, en las TRES llamadas de Auth: signInWithPassword,
//   resetPasswordForEmail y signUp. Se les olvidó cubrir el login y la
//   recuperación en su primera versión, y por eso se quedaron bloqueados
//   hasta de su propio panel de admin — aquí se cubren los tres desde el
//   principio para no repetir ese fallo.
// - El site key que ya tienen (0x4AAAAAAEXdHW6UM2BzY75G) está atado en
//   Cloudflare solo al hostname app.copermiq.com. Para que funcione aquí,
//   Miq tiene que añadir copermiq.com (y probablemente www.copermiq.com) a
//   la lista de hostnames permitidos de ESE MISMO widget en el panel de
//   Cloudflare (Turnstile → ese widget → Settings) — así se reutiliza la
//   misma Secret Key ya configurada en Supabase, sin tocar nada más ahí.
//   Sin ese paso (que solo puede hacerlo Miq, no es código), el widget
//   cargará pero Cloudflare lo rechazará por dominio no autorizado.
// - Se usa el modo explícito (`turnstile.render()`, no el automático) tal
//   como recomendó la app — aunque aquí el formulario no se reconstruye en
//   cada render (a diferencia del suyo), el modo explícito da control
//   directo sobre cuándo resetear el widget (tras cada intento, para que
//   el siguiente tenga un token fresco) y sobre qué token va a cada
//   llamada, así que se mantiene por seguridad y no por necesidad estricta.
// - Estética: `theme: 'light'` fijo (la tarjeta del modal es blanca,
//   `--card:#FFFFFF`) y el contenedor del widget con `border-radius` +
//   `overflow:hidden` para redondear las esquinas del iframe — el propio
//   contenido de dentro no se puede repintar por venir de otro dominio,
//   pero el marco sí.
//
// Falta un dato que SOLO Miq puede rellenar (no se puede inventar, mismo
// criterio que con las claves de Supabase): el site key real de Turnstile,
// como variable de entorno PUBLIC_TURNSTILE_SITE_KEY (ver .env.example y
// el mismo patrón de src/lib/supabaseClient.js). Sin esa variable, el
// formulario se deshabilita con un aviso — igual que ya pasaba antes si
// faltaban las claves de Supabase — en vez de fallar en seco.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const hasTurnstileKey = Boolean(turnstileSiteKey);
---

<div id="auth-overlay" class="auth-overlay" hidden>
  <div class="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-title">
    <button type="button" class="auth-close" aria-label="Cerrar">
      <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Estado: sin sesión iniciada -->
    <div id="auth-signed-out">
      <div class="auth-tabs" role="tablist">
        <button type="button" class="auth-tab is-active" data-auth-tab="login" role="tab" aria-selected="true">Iniciar sesión</button>
        <button type="button" class="auth-tab" data-auth-tab="signup" role="tab" aria-selected="false">Crear cuenta</button>
      </div>

      <h3 id="auth-title" class="auth-heading">Accede a tu cuenta Copermiq</h3>

      <form id="auth-login-form" class="auth-form" data-auth-panel="login">
        <label>
          Email
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          Contraseña
          <input type="password" name="password" autocomplete="current-password" required minlength="6" />
        </label>
        <!-- Un solo widget cubre "Iniciar sesión" y "He olvidado mi
             contraseña" — ambas acciones viven en este mismo formulario
             visible, y el token se resetea tras cada intento. -->
        {hasTurnstileKey && <div id="turnstile-login" class="turnstile-wrap" data-sitekey={turnstileSiteKey}></div>}
        <button type="submit" class="btn btn-primary auth-submit">Iniciar sesión</button>
        <button type="button" class="auth-forgot">He olvidado mi contraseña</button>
      </form>

      <form id="auth-signup-form" class="auth-form" data-auth-panel="signup" hidden>
        <label>
          Email
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          Contraseña
          <input type="password" name="password" autocomplete="new-password" required minlength="6" />
        </label>
        {hasTurnstileKey && <div id="turnstile-signup" class="turnstile-wrap" data-sitekey={turnstileSiteKey}></div>}
        <button type="submit" class="btn btn-primary auth-submit">Crear cuenta</button>
      </form>

      <p id="auth-message" class="auth-message" role="alert"></p>
    </div>
  </div>
</div>

<!-- Ventana de confirmación de cierre de sesión. Antes había un botón
     "Cerrar sesión" suelto en /cuenta; ahora vive detrás del icono de
     cuenta de la cabecera (ver más abajo), para dejar libre esa pantalla
     para el panel de administración. -->
<div id="logout-overlay" class="auth-overlay" hidden>
  <div class="auth-modal logout-modal" role="dialog" aria-modal="true" aria-labelledby="logout-title">
    <button type="button" id="logout-close" class="auth-close" aria-label="Cerrar">
      <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
    <h3 id="logout-title" class="auth-heading">Cerrar sesión</h3>
    <p class="logout-text">¿Seguro que quieres cerrar tu sesión?</p>
    <div class="logout-actions">
      <button type="button" id="logout-cancel" class="btn btn-ghost">Cancelar</button>
      <button type="button" id="logout-confirm" class="btn btn-primary">Cerrar sesión</button>
    </div>
  </div>
</div>

{hasTurnstileKey && (
  <script is:inline>
    // Promesa que se resuelve cuando el script de Cloudflare ha cargado y
    // `window.turnstile` ya existe — el módulo de abajo espera a esto antes
    // de intentar renderizar los widgets. `render=explicit` evita que
    // Cloudflare los monte solo, para poder controlar nosotros el reset.
    window.__turnstileReady = new Promise((resolve) => {
      window.onloadTurnstileCallback = resolve;
    });
  </script>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileCallback&render=explicit" async defer></script>
)}

<script>
  import { supabase, isSupabaseConfigured } from '../lib/supabaseClient.js';

  const overlay = document.getElementById('auth-overlay');
  const closeBtn = document.querySelector('#auth-overlay .auth-close');
  const accountBtn = document.getElementById('account-toggle');
  const accountUsernameEl = document.getElementById('account-username');
  const menuAccountLink = document.getElementById('menu-account-link');

  const tabs = document.querySelectorAll('.auth-tab');
  const loginForm = document.getElementById('auth-login-form');
  const signupForm = document.getElementById('auth-signup-form');
  const messageEl = document.getElementById('auth-message');
  const forgotBtn = document.querySelector('.auth-forgot');

  // A dónde manda Supabase a la persona tras pinchar el enlace del email de
  // "recuperar contraseña" — confirmado por la app el 2026-08-09: es la
  // raíz de la app, SIN ningún sufijo como /reset-password (la propia app
  // detecta ahí la sesión de recuperación que añade Supabase). La app
  // también confirmó que el flujo de invitación por enlace mágico ya
  // funciona usando este mismo mecanismo, así que este dominio (o un
  // patrón que lo cubra) ya debería estar en Supabase Auth → URL
  // Configuration → Redirect URLs — pero eso solo se puede comprobar
  // mirando ese panel directamente (ni la app ni esta sesión tienen forma
  // de verlo), así que Miq debe confirmarlo ahí con sus propios ojos.
  const RESET_PASSWORD_URL = 'https://app.copermiq.com/';

  const logoutOverlay = document.getElementById('logout-overlay');
  const logoutClose = document.getElementById('logout-close');
  const logoutCancel = document.getElementById('logout-cancel');
  const logoutConfirmBtn = document.getElementById('logout-confirm');

  function openModal() {
    if (!overlay) return;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!overlay) return;
    overlay.hidden = true;
    document.body.style.overflow = '';
  }

  function openLogoutConfirm() {
    if (!logoutOverlay) return;
    logoutOverlay.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeLogoutConfirm() {
    if (!logoutOverlay) return;
    logoutOverlay.hidden = true;
    document.body.style.overflow = '';
  }

  // Con sesión iniciada, el icono de cuenta ya no lleva directamente a
  // /cuenta (ese enlace ahora vive en el menú, como "Mi cuenta") — pregunta
  // primero si quieres cerrar sesión, que es la acción que antes era un
  // botón suelto dentro de /cuenta.
  accountBtn?.addEventListener('click', () => {
    if (accountBtn.classList.contains('is-connected')) {
      openLogoutConfirm();
      return;
    }
    openModal();
  });
  closeBtn?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', (event) => {
    if (event.target === overlay) closeModal();
  });
  logoutClose?.addEventListener('click', closeLogoutConfirm);
  logoutCancel?.addEventListener('click', closeLogoutConfirm);
  logoutOverlay?.addEventListener('click', (event) => {
    if (event.target === logoutOverlay) closeLogoutConfirm();
  });
  logoutConfirmBtn?.addEventListener('click', async () => {
    if (!supabase) return;
    logoutConfirmBtn.setAttribute('disabled', 'true');
    await supabase.auth.signOut();
    window.location.href = '/';
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (overlay && !overlay.hidden) closeModal();
    if (logoutOverlay && !logoutOverlay.hidden) closeLogoutConfirm();
  });

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');

      const target = tab.getAttribute('data-auth-tab');
      if (loginForm instanceof HTMLElement) loginForm.hidden = target !== 'login';
      if (signupForm instanceof HTMLElement) signupForm.hidden = target !== 'signup';
      setMessage('');
    });
  });

  function setMessage(text, tone) {
    if (!messageEl) return;
    messageEl.textContent = text;
    messageEl.className = 'auth-message' + (tone ? ' ' + tone : '');
  }

  // Traduce los mensajes de error de Supabase a español, para no mostrar
  // texto técnico en inglés directamente al usuario.
  function translateError(error) {
    const msg = error?.message || '';
    if (/already registered|user already exists/i.test(msg)) {
      return 'Ese email ya tiene una cuenta. Prueba a iniciar sesión.';
    }
    if (/invalid login credentials/i.test(msg)) {
      return 'Email o contraseña incorrectos.';
    }
    if (/password should be at least/i.test(msg)) {
      return 'La contraseña debe tener al menos 6 caracteres.';
    }
    if (/email not confirmed/i.test(msg)) {
      return 'Confirma tu email antes de iniciar sesión — revisa tu bandeja de entrada.';
    }
    if (/unable to validate email address|invalid email/i.test(msg)) {
      return 'Ese email no parece válido.';
    }
    if (/security purposes.*only request this/i.test(msg)) {
      return 'Ya se ha enviado un email hace poco — espera un momento antes de volver a pedirlo.';
    }
    return msg || 'Ha ocurrido un error. Inténtalo de nuevo.';
  }

  // ----------------------------------------------------------------------
  // Cloudflare Turnstile — ver el comentario largo al principio del
  // frontmatter para el porqué. `loginToken`/`signupToken` guardan el
  // token vigente de cada widget; se limpian al montar, al expirar y tras
  // cada intento (con éxito o con error), para que el siguiente intento
  // siempre mande un token fresco — un token de Turnstile es de un solo
  // uso.
  const hasTurnstileKey = Boolean(document.getElementById('turnstile-login') || document.getElementById('turnstile-signup'));
  let loginWidgetId = null;
  let signupWidgetId = null;
  let loginToken = '';
  let signupToken = '';

  async function renderTurnstileWidgets() {
    if (!hasTurnstileKey || !window.__turnstileReady) return;
    await window.__turnstileReady;
    const loginEl = document.getElementById('turnstile-login');
    const signupEl = document.getElementById('turnstile-signup');
    if (loginEl && window.turnstile) {
      loginWidgetId = window.turnstile.render(loginEl, {
        sitekey: loginEl.dataset.sitekey,
        theme: 'light',
        size: 'flexible',
        callback: (token) => { loginToken = token; },
        'expired-callback': () => { loginToken = ''; },
        'error-callback': () => { loginToken = ''; },
      });
    }
    if (signupEl && window.turnstile) {
      signupWidgetId = window.turnstile.render(signupEl, {
        sitekey: signupEl.dataset.sitekey,
        theme: 'light',
        size: 'flexible',
        callback: (token) => { signupToken = token; },
        'expired-callback': () => { signupToken = ''; },
        'error-callback': () => { signupToken = ''; },
      });
    }
  }
  renderTurnstileWidgets();

  function resetLoginWidget() {
    loginToken = '';
    if (window.turnstile && loginWidgetId !== null) window.turnstile.reset(loginWidgetId);
  }
  function resetSignupWidget() {
    signupToken = '';
    if (window.turnstile && signupWidgetId !== null) window.turnstile.reset(signupWidgetId);
  }

  if (!isSupabaseConfigured) {
    setMessage(
      'Configuración pendiente: faltan las claves de Supabase (ver src/lib/supabaseClient.js).',
      'error'
    );
    loginForm?.querySelectorAll('input, button').forEach((el) => (el.disabled = true));
    signupForm?.querySelectorAll('input, button').forEach((el) => (el.disabled = true));
  } else if (!hasTurnstileKey) {
    // Desde que se activó "Attack Protection" en Supabase (proyecto
    // compartido con la app, 2026-08-21), el login/alta/recuperación no
    // funcionan sin un token de Turnstile — así que sin la clave
    // configurada, es más honesto avisar y deshabilitar el formulario que
    // dejar que la persona lo intente y se encuentre un error técnico.
    setMessage(
      'Configuración pendiente: falta la clave de Cloudflare Turnstile (ver src/components/AuthModal.astro).',
      'error'
    );
    loginForm?.querySelectorAll('input, button').forEach((el) => (el.disabled = true));
    signupForm?.querySelectorAll('input, button').forEach((el) => (el.disabled = true));
  }

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!supabase) return;
    if (hasTurnstileKey && !loginToken) {
      setMessage('Espera un momento a que cargue la verificación de seguridad e inténtalo de nuevo.', 'error');
      return;
    }
    setMessage('Comprobando…');
    const formData = new FormData(loginForm);
    const { data, error } = await supabase.auth.signInWithPassword({
      email: String(formData.get('email') || ''),
      password: String(formData.get('password') || ''),
      options: hasTurnstileKey ? { captchaToken: loginToken } : undefined,
    });
    resetLoginWidget();
    if (error) {
      setMessage(translateError(error), 'error');
      return;
    }
    setMessage('');
    loginForm.reset();
    if (data.session) window.location.href = '/cuenta';
  });

  // "He olvidado mi contraseña" — reutiliza el campo de email del propio
  // formulario de login (si ya lo ha escrito) en vez de pedirlo aparte, y
  // el mismo widget de Turnstile del formulario de login (misma sección
  // visible). resetPasswordForEmail() es una llamada directa al Auth de
  // Supabase (no una Edge Function propia ni de la app), así que no hay
  // nada nuevo que desplegar — ver el comentario de RESET_PASSWORD_URL
  // arriba.
  forgotBtn?.addEventListener('click', async () => {
    if (!supabase) return;
    const emailInput = loginForm?.querySelector('input[name="email"]');
    const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
    if (!email) {
      setMessage('Escribe tu email arriba y vuelve a pulsar "He olvidado mi contraseña".', 'error');
      if (emailInput instanceof HTMLInputElement) emailInput.focus();
      return;
    }
    if (hasTurnstileKey && !loginToken) {
      setMessage('Espera un momento a que cargue la verificación de seguridad e inténtalo de nuevo.', 'error');
      return;
    }
    if (forgotBtn instanceof HTMLButtonElement) forgotBtn.disabled = true;
    setMessage('Enviando…');
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: RESET_PASSWORD_URL,
      ...(hasTurnstileKey ? { captchaToken: loginToken } : {}),
    });
    resetLoginWidget();
    if (forgotBtn instanceof HTMLButtonElement) forgotBtn.disabled = false;
    if (error) {
      setMessage(translateError(error), 'error');
      return;
    }
    setMessage('Te hemos enviado un email con un enlace para elegir una contraseña nueva.', 'success');
  });

  signupForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!supabase) return;
    if (hasTurnstileKey && !signupToken) {
      setMessage('Espera un momento a que cargue la verificación de seguridad e inténtalo de nuevo.', 'error');
      return;
    }
    setMessage('Creando cuenta…');
    const formData = new FormData(signupForm);
    const { data, error } = await supabase.auth.signUp({
      email: String(formData.get('email') || ''),
      password: String(formData.get('password') || ''),
      options: hasTurnstileKey ? { captchaToken: signupToken } : undefined,
    });
    resetSignupWidget();
    if (error) {
      setMessage(translateError(error), 'error');
      return;
    }
    signupForm.reset();
    if (data.session) {
      // El proyecto no exige confirmación por email: ya hay sesión activa.
      window.location.href = '/cuenta';
      return;
    }
    setMessage('Cuenta creada. Revisa tu email para confirmarla antes de iniciar sesión.', 'success');
  });

  // Refleja el estado de sesión en el icono de cuenta de la cabecera:
  // nombre de usuario + punto verde de "conectado", y muestra/oculta el
  // enlace "Mi cuenta" del menú (solo tiene sentido con sesión iniciada).
  function renderSession(session) {
    const isSignedIn = Boolean(session?.user);
    accountBtn?.classList.toggle('is-connected', isSignedIn);
    if (accountUsernameEl) {
      accountUsernameEl.textContent = isSignedIn ? (session.user.email?.split('@')[0] ?? '') : '';
    }
    if (menuAccountLink instanceof HTMLElement) menuAccountLink.hidden = !isSignedIn;
  }

  if (supabase) {
    supabase.auth.getSession().then(({ data }) => renderSession(data.session));
    supabase.auth.onAuthStateChange((_event, session) => renderSession(session));
  }
</script>
