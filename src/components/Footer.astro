---
const year = 2026;
---

<footer>
  <div class="wrap">
    <div class="footer-main">
      <div class="footer-brand">
        <img src="/images/copernico-mark.webp" alt="Copermiq" />
        <span>Copermiq</span>
      </div>
      <p class="footer-tagline">Contabilidad Personal, por Miq</p>

      <!-- Mini menú del footer — 2026-08-20, a petición de Miq. -->
      <nav class="footer-links" aria-label="Enlaces del pie de página">
        <a href="/preguntas-frecuentes">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
            <path d="M9.5 9a2.5 2.5 0 1 1 3.3 2.36c-.66.24-1.05.73-1.05 1.39v.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M12 16.5h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
          Preguntas frecuentes
        </a>
        <a href="/privacidad">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Privacidad
        </a>
      </nav>
    </div>
    <p class="footer-copy">© {year} Copermiq. Todos los derechos reservados.</p>
  </div>
</footer>
