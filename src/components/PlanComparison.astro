---
// Tabla comparativa de planes, integrada en /#precios (home). Cada fila
// viene de una fuente verificable: el changelog real de la app (README.md,
// CopperMiq-main), Supabase (región eu-central-1 = Frankfurt), o
// confirmación directa de Miq (2026-08-19) para el reparto exacto por plan
// de pago. Nota de nombres: el plan intermedio (key interna 'subscription'
// / 'suscripcion' en Stripe y Supabase, sin cambios) se llama de cara al
// público "Pro" desde el 2026-08-19 — antes aparecía como "Suscripción".
// - Libros registro: solo Premium (no Pro, aunque el changelog de la app
//   decía "a partir de Suscripción" — Miq confirmó que la decisión final de
//   negocio es Premium en exclusiva).
// - Colores de marca personalizables: solo Premium (mismo caso).
// - Facturas periódicas/recurrentes y categorías de gasto personalizables:
//   confirmadas como "a partir de Pro", tal como ya decía la web.
// - IVA por inversión del sujeto pasivo y moneda extranjera en gastos:
//   confirmadas como "a partir de Pro" (2026-08-19), no disponibles en el
//   plan Gratis como se había puesto inicialmente.

const CHECK = '✓';
const DASH = '—';

// Fila destacada, sin grupo propio, justo debajo de la cabecera — así
// viene en la página 4 del PDF real que pasó Miq el 2026-08-22 (no al
// final de la tabla, como se entendió en un primer momento).
//
// Corrección 2026-08-31: esta fila llevaba `soon: true` Y los 3 planes en
// CHECK a la vez — la plantilla ni siquiera leía ese campo, pintaba la
// etiqueta "Próximamente" a pedales siempre, así que la fila se
// contradecía a sí misma (✓ en los tres planes + "aún no está"). Con el
// nuevo plan LT (ver HeroCta.astro y Pricing.astro), esto por fin tiene
// una explicación limpia: Verifactu está apagado solo en LT (que no
// tiene columna propia aquí, es el estado inicial antes de "dar el
// salto"), y encendido de verdad desde Basic (antes "Gratis") en
// adelante — así que para los tres planes que sí aparecen en esta tabla,
// el CHECK ya no es contradictorio, es la realidad.
const verifactuRow = {
  label: 'Cumplimiento Verifactu (facturación electrónica antifraude)',
  free: CHECK, sub: CHECK, premium: CHECK,
};

const groups = [
  {
    title: 'Facturación y presupuestos',
    rows: [
      { label: 'Facturas y presupuestos ilimitados', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Facturas rectificativas conforme a normativa', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Facturas periódicas / recurrentes', free: DASH, sub: CHECK, premium: CHECK },
      { label: 'PDF sin pie de marca "generado con Copermiq"', free: DASH, sub: CHECK, premium: CHECK },
    ],
  },
  {
    title: 'Gastos y proveedores',
    rows: [
      { label: 'Registro de gastos con IVA e IRPF', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Proveedores', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Categorías de gasto personalizables', free: DASH, sub: CHECK, premium: CHECK },
      { label: 'IVA por inversión del sujeto pasivo (proveedores extranjeros)', free: DASH, sub: CHECK, premium: CHECK },
      { label: 'Moneda extranjera en gastos', free: DASH, sub: CHECK, premium: CHECK },
      { label: 'Escáner de gasto con IA (rellena el gasto con foto)', free: DASH, sub: DASH, premium: CHECK, badge: 'En proceso' },
      { label: 'Gestor avanzado de clientes (ERP)', free: DASH, sub: DASH, premium: CHECK },
    ],
  },
  {
    title: 'Ayuda fiscal',
    rows: [
      { label: 'Modelos 303 / 130 / 390 (ayuda orientativa)', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Libros registro (facturas emitidas y recibidas)', free: DASH, sub: DASH, premium: CHECK },
    ],
  },
  {
    title: 'Seguridad y cuenta',
    rows: [
      { label: 'Verificación en dos pasos (2FA)', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Contraseñas fuertes obligatorias', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Copia de seguridad manual (JSON)', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Copia de seguridad automática (email)', free: DASH, sub: CHECK, premium: CHECK },
      { label: 'Datos alojados en la UE (Frankfurt)', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Copias de seguridad en la nube de Google Drive', free: DASH, sub: DASH, premium: CHECK },
    ],
  },
  {
    title: 'Personalización y comodidad',
    rows: [
      { label: 'App instalable en el móvil (PWA), sin tiendas de apps', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Bilingüe castellano / catalán', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Modo claro / oscuro', free: CHECK, sub: CHECK, premium: CHECK },
      { label: 'Colores de marca personalizables', free: DASH, sub: DASH, premium: CHECK },
      { label: 'Soporte prioritario', free: DASH, sub: DASH, premium: CHECK },
    ],
  },
];
---

<section class="plan-comparison">
  <div class="wrap section-head">
    <h2>Compara los planes al detalle</h2>
    <p>
      Todo lo marcado aquí existe ya en la app — con las excepciones
      marcadas abajo, que llegan muy pronto.
    </p>
  </div>

  <div class="wrap">
    <div class="plan-comparison-scroll">
      <table class="plan-comparison-table">
        <thead>
          <tr>
            <th scope="col" class="pc-feature-col">Funcionalidad</th>
            <th scope="col">Basic</th>
            <th scope="col" class="pc-highlight-col">Pro</th>
            <th scope="col">Premium</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" class="pc-feature-col">
              {verifactuRow.label}
            </th>
            <td class:list={{ 'pc-yes': verifactuRow.free === CHECK }}>{verifactuRow.free}</td>
            <td class:list={['pc-highlight-col', { 'pc-yes': verifactuRow.sub === CHECK }]}>{verifactuRow.sub}</td>
            <td class:list={{ 'pc-yes': verifactuRow.premium === CHECK }}>{verifactuRow.premium}</td>
          </tr>
        </tbody>
        {groups.map((group) => (
          <tbody>
            <tr class="pc-group-row">
              <th scope="colgroup" colspan="4">{group.title}</th>
            </tr>
            {group.rows.map((row) => (
              <tr class:list={{ 'pc-row-soon': Boolean(row.badge) }}>
                <th scope="row" class="pc-feature-col">
                  {row.label}
                  {row.badge && <span class="pc-badge-soon">{row.badge}</span>}
                </th>
                <td class:list={{ 'pc-yes': row.free === CHECK, 'pc-no': row.free === DASH }}>{row.free}</td>
                <td class:list={['pc-highlight-col', { 'pc-yes': row.sub === CHECK, 'pc-no': row.sub === DASH }]}>{row.sub}</td>
                <td class:list={{ 'pc-yes': row.premium === CHECK, 'pc-no': row.premium === DASH }}>{row.premium}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </div>
</section>
