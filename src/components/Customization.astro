---
// Paleta real de la app (Preferencias → Interfaz). Cada color tiene una variante
// oscura y una clara — el botón de "Tono" cambia entre ellas, igual que en la app.
const palette = [
  { key: 'verde', label: 'Verde', dark: { bg: '#134430', fg: '#EAF3EC' }, light: { bg: '#DCEBE2', fg: '#14432C' } },
  { key: 'azul', label: 'Azul oscuro', dark: { bg: '#142A42', fg: '#E9F0F7' }, light: { bg: '#DCE7F3', fg: '#142A42' } },
  { key: 'naranja', label: 'Naranja', dark: { bg: '#5C2E0E', fg: '#FBEEE0' }, light: { bg: '#FBE6D2', fg: '#6B3510' } },
  { key: 'violeta', label: 'Violeta', dark: { bg: '#2E1F4D', fg: '#EDE7F7' }, light: { bg: '#E7DFF5', fg: '#34235A' } },
  { key: 'rosa', label: 'Rosa', dark: { bg: '#4A1F35', fg: '#F8E7EE' }, light: { bg: '#F7DCE7', fg: '#5A2440' } },
  { key: 'grisOscuro', label: 'Gris oscuro', dark: { bg: '#1C1F22', fg: '#EDEEEE' }, light: { bg: '#DEE0E2', fg: '#202325' } },
  { key: 'grisMedio', label: 'Gris medio', dark: { bg: '#4A5057', fg: '#F2F3F3' }, light: { bg: '#E4E6E7', fg: '#33383D' } },
  { key: 'marron', label: 'Marrón', dark: { bg: '#3B2A1E', fg: '#F1E7DC' }, light: { bg: '#EFE0D2', fg: '#4A3323' } },
];

const words = [
  { es: 'Inicio', ca: 'Inici' },
  { es: 'Facturas', ca: 'Factures' },
  { es: 'Gastos', ca: 'Despeses' },
  { es: 'Clientes', ca: 'Clients' },
  { es: 'Preferencias', ca: 'Preferències' },
];
---

<section id="personalizacion">
  <div class="wrap">
    <div class="section-head on-dark">
      <span class="eyebrow eyebrow-dark">A tu manera</span>
      <h2>Tus colores. Tu idioma. Tu Copermiq.</h2>
      <p>La interfaz se adapta a ti, no al revés: elige el color de la barra lateral, su tono claro u oscuro, el modo del contenido, y el idioma en el que quieres trabajar. Pruébalo aquí mismo.</p>
    </div>

    <div class="preview-switch">
      <span class="toggle-label-lg">Vista previa del contenido</span>
      <div class="toggle-pill toggle-pill-lg" id="contentToggle">
        <button type="button" class="toggle-option is-active" data-mode="light">Claro</button>
        <button type="button" class="toggle-option" data-mode="dark">Oscuro</button>
      </div>
    </div>

    <div class="custom-grid" id="demoArea">
      <div class="custom-card">
        <h3 class="custom-title">Colores a tu gusto</h3>
        <p class="custom-desc">Elige un color de barra lateral y prueba su tono oscuro o claro — los mismos colores, dos intensidades.</p>

        <div class="color-frame">
          <div class="color-frame-sidebar" id="colorSidebar" style="background:#134430;">
            <span class="color-frame-dot"></span>
            <span class="color-frame-bar" style="width:60%;"></span>
            <span class="color-frame-bar" style="width:40%;"></span>
            <span class="color-frame-bar" style="width:50%;"></span>
          </div>
          <div class="color-frame-body" id="colorBody">
            <span class="color-frame-line" style="width:70%;"></span>
            <span class="color-frame-line" style="width:45%;"></span>
            <span class="color-frame-card"></span>
          </div>
        </div>

        <div class="swatch-row" id="swatchRow">
          {palette.map((p) => (
            <button
              type="button"
              class={`swatch ${p.key === 'verde' ? 'is-active' : ''}`}
              style={`background:${p.dark.bg}`}
              data-key={p.key}
              data-bg-dark={p.dark.bg}
              data-fg-dark={p.dark.fg}
              data-bg-light={p.light.bg}
              data-fg-light={p.light.fg}
              aria-label={p.label}
              title={p.label}
            ></button>
          ))}
          <span class="swatch-label">Barra lateral</span>
        </div>

        <div class="toggle-mock">
          <span class="toggle-label">Tono</span>
          <span class="toggle-pill" id="toneToggle">
            <button type="button" class="toggle-option is-active" data-tone="dark">Oscuro</button>
            <button type="button" class="toggle-option" data-tone="light">Claro</button>
          </span>
        </div>
      </div>

      <div class="custom-card">
        <h3 class="custom-title">Castellano y català</h3>
        <p class="custom-desc">Toda la app —menús, formularios, facturas— está disponible en castellano y en català. Cambia de idioma cuando quieras, sin perder ni un dato.</p>

        <div class="lang-toggle" id="langToggle">
          <button type="button" class="lang-option is-active" data-lang="es">Castellano</button>
          <button type="button" class="lang-option" data-lang="ca">Català</button>
        </div>

        <div class="translate-table" id="translateTable">
          {words.map((w) => (
            <div class="translate-row">
              <span class="mono col-es is-active">{w.es}</span>
              <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="mono col-ca">{w.ca}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
    <p class="preview-caption on-dark">Recreación ilustrativa e interactiva de las opciones de color e idioma — no son capturas reales de la app.</p>
  </div>
</section>

<script>
  const sidebar = document.getElementById('colorSidebar');
  const swatchRow = document.getElementById('swatchRow');
  const body = document.getElementById('colorBody');
  const contentToggle = document.getElementById('contentToggle');
  const toneToggle = document.getElementById('toneToggle');
  const demoArea = document.getElementById('demoArea');
  const langToggle = document.getElementById('langToggle');
  const translateTable = document.getElementById('translateTable');

  let currentKey = 'verde';
  let currentTone = 'dark';

  function applySidebar() {
    const btn = swatchRow?.querySelector(`.swatch[data-key="${currentKey}"]`);
    if (!btn || !sidebar) return;
    const bg = currentTone === 'dark' ? btn.dataset.bgDark : btn.dataset.bgLight;
    const fg = currentTone === 'dark' ? btn.dataset.fgDark : btn.dataset.fgLight;
    sidebar.style.background = bg;
    sidebar.style.setProperty('--sb-fg', fg);
  }

  function refreshSwatchSwatches() {
    swatchRow?.querySelectorAll('.swatch').forEach((btn) => {
      const bg = currentTone === 'dark' ? btn.dataset.bgDark : btn.dataset.bgLight;
      btn.style.background = bg;
    });
  }

  swatchRow?.querySelectorAll('.swatch').forEach((btn) => {
    btn.addEventListener('click', () => {
      swatchRow.querySelectorAll('.swatch').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      currentKey = btn.getAttribute('data-key') || currentKey;
      applySidebar();
    });
  });

  toneToggle?.querySelectorAll('.toggle-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      toneToggle.querySelectorAll('.toggle-option').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      currentTone = btn.getAttribute('data-tone') || currentTone;
      refreshSwatchSwatches();
      applySidebar();
    });
  });

  contentToggle?.querySelectorAll('.toggle-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      contentToggle.querySelectorAll('.toggle-option').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const mode = btn.getAttribute('data-mode');
      const isDark = mode === 'dark';
      demoArea?.classList.toggle('theme-dark', isDark);
    });
  });

  langToggle?.querySelectorAll('.lang-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      langToggle.querySelectorAll('.lang-option').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const lang = btn.getAttribute('data-lang');
      translateTable?.querySelectorAll('.col-es').forEach((el) => el.classList.toggle('is-active', lang === 'es'));
      translateTable?.querySelectorAll('.col-ca').forEach((el) => el.classList.toggle('is-active', lang === 'ca'));
    });
  });

  applySidebar();
</script>
