---
// Paleta real de la app (Preferencias → Interfaz). Cada color tiene una variante
// oscura y una clara — el botón de "Tono" cambia entre ellas, igual que en la app.
const palette = [
  { key: 'verde', label: 'Verde', dark: { bg: '#134430', fg: '#EAF3EC' }, light: { bg: '#DCEBE2', fg: '#14432C' } },
  { key: 'azul', label: 'Azul oscuro', dark: { bg: '#142A42', fg: '#E9F0F7' }, light: { bg: '#DCE7F3', fg: '#142A42' } },
  { key: 'naranja', label: 'Naranja', dark: { bg: '#5C2E0E', fg: '#FBEEE0' }, light: { bg: '#FBE6D2', fg: '#6B3510' } },
  { key: 'violeta', label: 'Violeta', dark: { bg: '#2E1F4D', fg: '#EDE7F7' }, light: { bg: '#E7DFF5', fg: '#34235A' } },
  { key: 'rosa', label: 'Rosa', dark: { bg: '#4A1F35', fg: '#F8E7EE' }, light: { bg: '#F7DCE7', fg: '#5A2440' } },
  { key: 'grisOscuro', label: 'Gris oscuro', dark: { bg: '#1C1F22', fg: '#EDEEEE' }, light: { bg: '#DEE0E2', fg: '#202325' } },
  { key: 'grisMedio', label: 'Gris medio', dark: { bg: '#4A5057', fg: '#F2F3F3' }, light: { bg: '#E4E6E7', fg: '#33383D' } },
  { key: 'marron', label: 'Marrón', dark: { bg: '#3B2A1E', fg: '#F1E7DC' }, light: { bg: '#EFE0D2', fg: '#4A3323' } },
];

// Cápsula de idioma (tarjeta derecha de "A tu manera") — a petición de Miq
// del 2026-08-22, reconstruida con el CSS/HTML/JS REAL del desplegable de
// idioma de la app (style.css líneas 449-486 y app.js líneas 472-473,
// 4453-4461 — copia literal, incluida la clase `.active` en vez de la
// convención `.is-active` que usa el resto de esta web, para mantener
// fidelidad exacta con el componente real). Sustituye al toggle+tabla de
// traducción anterior (ver historial de commits si hace falta recuperarlo).
//
// El desplegable de Castellano/Català es REAL e interactivo (abre/cierra al
// clicar, la opción elegida actualiza el texto y la bandera del botón) — sin
// flecha de cursor dibujada, el cursor real del usuario hace ese papel. Por
// defecto se muestra ya abierto (como en las capturas de Miq) para que se
// vea de un vistazo sin necesitar clic, pero sigue siendo 100% funcional.
//
// El segundo desplegable (5 lenguas) es una ilustración ESTÁTICA, no
// interactiva y sin idioma marcado como seleccionado — a propósito, porque
// valenciano/gallego/euskera no existen todavía en la app. Las 3 banderas de
// esas lenguas son de muestra (no son las reales de la app, que solo tiene
// bandera de España y de Catalunya) — dibujadas por Miq mismo para este
// mockup, con su permiso explícito para usarlas así.
---

<section id="personalizacion" class="tinted-section">
  <div class="wrap">
    <div class="section-head on-dark">
      <span class="eyebrow eyebrow-dark">A tu manera</span>
      <h2>Tus colores. Tu idioma. Tu Copermiq.</h2>
      <p>La interfaz se adapta a ti, no al revés: elige el color de la barra lateral, su tono claro u oscuro, el modo del contenido, y el idioma en el que quieres trabajar. Pruébalo aquí mismo.</p>
      <p class="origin-statement">
        <span class="origin-flag" aria-hidden="true">
          <svg viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
            <rect width="300" height="200" fill="#003399"/>
            <path d="M150.0,20.5 L152.13,27.06 L159.04,27.06 L153.45,31.12 L155.58,37.69 L150.0,33.63 L144.42,37.69 L146.55,31.12 L140.96,27.06 L147.87,27.06 Z" fill="#FFCC00"/>
            <path d="M185.0,29.88 L187.13,36.44 L194.04,36.44 L188.45,40.5 L190.58,47.06 L185.0,43.01 L179.42,47.06 L181.55,40.5 L175.96,36.44 L182.87,36.44 Z" fill="#FFCC00"/>
            <path d="M210.62,55.5 L212.75,62.06 L219.66,62.06 L214.07,66.12 L216.21,72.69 L210.62,68.63 L205.04,72.69 L207.17,66.12 L201.59,62.06 L208.49,62.06 Z" fill="#FFCC00"/>
            <path d="M220.0,90.5 L222.13,97.06 L229.04,97.06 L223.45,101.12 L225.58,107.69 L220.0,103.63 L214.42,107.69 L216.55,101.12 L210.96,97.06 L217.87,97.06 Z" fill="#FFCC00"/>
            <path d="M210.62,125.5 L212.75,132.06 L219.66,132.06 L214.07,136.12 L216.21,142.69 L210.62,138.63 L205.04,142.69 L207.17,136.12 L201.59,132.06 L208.49,132.06 Z" fill="#FFCC00"/>
            <path d="M185.0,151.12 L187.13,157.69 L194.04,157.69 L188.45,161.74 L190.58,168.31 L185.0,164.25 L179.42,168.31 L181.55,161.74 L175.96,157.69 L182.87,157.69 Z" fill="#FFCC00"/>
            <path d="M150.0,160.5 L152.13,167.06 L159.04,167.06 L153.45,171.12 L155.58,177.69 L150.0,173.63 L144.42,177.69 L146.55,171.12 L140.96,167.06 L147.87,167.06 Z" fill="#FFCC00"/>
            <path d="M115.0,151.12 L117.13,157.69 L124.04,157.69 L118.45,161.74 L120.58,168.31 L115.0,164.25 L109.42,168.31 L111.55,161.74 L105.96,157.69 L112.87,157.69 Z" fill="#FFCC00"/>
            <path d="M89.38,125.5 L91.51,132.06 L98.41,132.06 L92.83,136.12 L94.96,142.69 L89.38,138.63 L83.79,142.69 L85.93,136.12 L80.34,132.06 L87.25,132.06 Z" fill="#FFCC00"/>
            <path d="M80.0,90.5 L82.13,97.06 L89.04,97.06 L83.45,101.12 L85.58,107.69 L80.0,103.63 L74.42,107.69 L76.55,101.12 L70.96,97.06 L77.87,97.06 Z" fill="#FFCC00"/>
            <path d="M89.38,55.5 L91.51,62.06 L98.41,62.06 L92.83,66.12 L94.96,72.69 L89.38,68.63 L83.79,72.69 L85.93,66.12 L80.34,62.06 L87.25,62.06 Z" fill="#FFCC00"/>
            <path d="M115.0,29.88 L117.13,36.44 L124.04,36.44 L118.45,40.5 L120.58,47.06 L115.0,43.01 L109.42,47.06 L111.55,40.5 L105.96,36.44 L112.87,36.44 Z" fill="#FFCC00"/>
          </svg>
        </span>
        <span><strong>Copermiq es un software europeo, hecho en España.</strong> Una app de proximidad, km. 0. Pensada por gente como tú, y desarrollada para ti.</span>
      </p>
    </div>

    <div class="preview-switch">
      <div class="toggle-pill toggle-pill-lg toggle-pill-ondark" id="contentToggle">
        <button type="button" class="toggle-option is-active" data-mode="light">Claro</button>
        <button type="button" class="toggle-option" data-mode="dark">Oscuro</button>
      </div>
    </div>

    <div class="custom-grid" id="demoArea">
      <div class="custom-card">
        <h3 class="custom-title">Colores a tu gusto</h3>
        <p class="custom-desc">Elige un color de barra lateral y prueba su tono oscuro o claro — los mismos colores, dos intensidades.</p>

        <div class="color-frame">
          <div class="color-frame-sidebar" id="colorSidebar" style="background:#134430;">
            <span class="color-frame-dot"></span>
            <span class="color-frame-bar" style="width:60%;"></span>
            <span class="color-frame-bar" style="width:40%;"></span>
            <span class="color-frame-bar" style="width:50%;"></span>
          </div>
          <div class="color-frame-body" id="colorBody">
            <span class="color-frame-line" style="width:70%;"></span>
            <span class="color-frame-line" style="width:45%;"></span>
            <span class="color-frame-card"></span>
          </div>
        </div>

        <div class="swatch-row" id="swatchRow">
          {palette.map((p) => (
            <button
              type="button"
              class={`swatch ${p.key === 'verde' ? 'is-active' : ''}`}
              style={`background:${p.dark.bg}`}
              data-key={p.key}
              data-bg-dark={p.dark.bg}
              data-fg-dark={p.dark.fg}
              data-bg-light={p.light.bg}
              data-fg-light={p.light.fg}
              aria-label={p.label}
              title={p.label}
            ></button>
          ))}
          <span class="swatch-label">Barra lateral</span>
        </div>

        <div class="toggle-mock">
          <span class="toggle-label">Tono</span>
          <span class="toggle-pill" id="toneToggle">
            <button type="button" class="toggle-option is-active" data-tone="dark">Oscuro</button>
            <button type="button" class="toggle-option" data-tone="light">Claro</button>
          </span>
        </div>
      </div>

      <div class="custom-card">
        <h3 class="custom-title">Castellano y català</h3>
        <p class="custom-desc">Copermiq habla 2 lenguas: castellano y català. Toda la app —menús, formularios, facturas, etc.— cambia de idioma cuando tú lo selecciones, sin perder ni un dato.</p>

        <!-- Desplegable REAL de idioma (Castellano/Català) — interactivo de verdad -->
        <div class="lang-dropdown is-open" id="langDropdown">
          <button type="button" class="lang-dropdown-btn" id="langDropdownBtn" aria-haspopup="listbox" aria-expanded="true">
            <span class="lang-dropdown-current">
              <span class="lang-flag" data-flag="es">
                <svg viewBox="0 0 24 16" width="20" height="14" aria-hidden="true"><rect width="24" height="16" fill="#AA151B"/><rect y="4" width="24" height="8" fill="#F1BF00"/></svg>
              </span>
              <span class="lang-flag" data-flag="ca" hidden>
                <svg viewBox="0 0 24 16" width="20" height="14" aria-hidden="true"><rect width="24" height="16" fill="#FCDD09"/><rect y="1.14" width="24" height="1.14" fill="#DA121A"/><rect y="3.43" width="24" height="1.14" fill="#DA121A"/><rect y="5.71" width="24" height="1.14" fill="#DA121A"/><rect y="8" width="24" height="1.14" fill="#DA121A"/><rect y="10.29" width="24" height="1.14" fill="#DA121A"/><rect y="12.57" width="24" height="1.14" fill="#DA121A"/><rect y="14.86" width="24" height="1.14" fill="#DA121A"/></svg>
              </span>
              <span id="langDropdownLabel">Castellano</span>
            </span>
            <svg class="nav-chevron-lang open" id="langChevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="lang-dropdown-panel" id="langDropdownPanel" role="listbox">
            <div class="lang-dropdown-option active" data-lang="es" data-label="Castellano" role="option" aria-selected="true" tabindex="0">
              <svg viewBox="0 0 24 16" width="20" height="14" aria-hidden="true"><rect width="24" height="16" fill="#AA151B"/><rect y="4" width="24" height="8" fill="#F1BF00"/></svg>
              <span>Castellano</span>
            </div>
            <div class="lang-dropdown-option" data-lang="ca" data-label="Català" role="option" aria-selected="false" tabindex="0">
              <svg viewBox="0 0 24 16" width="20" height="14" aria-hidden="true"><rect width="24" height="16" fill="#FCDD09"/><rect y="1.14" width="24" height="1.14" fill="#DA121A"/><rect y="3.43" width="24" height="1.14" fill="#DA121A"/><rect y="5.71" width="24" height="1.14" fill="#DA121A"/><rect y="8" width="24" height="1.14" fill="#DA121A"/><rect y="10.29" width="24" height="1.14" fill="#DA121A"/><rect y="12.57" width="24" height="1.14" fill="#DA121A"/><rect y="14.86" width="24" height="1.14" fill="#DA121A"/></svg>
              <span>Català</span>
            </div>
          </div>
        </div>

        <p class="custom-desc lang-roadmap-desc">Próximamente se adaptará también a otras lenguas co-oficiales de España: valenciano, gallego y euskera.</p>

        <!-- Ilustración estática (no interactiva, sin idioma seleccionado): banderas de
             Valencià/Galego/Euskara son de muestra, no existen todavía en la app -->
        <div class="lang-dropdown lang-dropdown-static" aria-hidden="true">
          <div class="lang-dropdown-panel lang-dropdown-panel--static">
            <div class="lang-dropdown-option">
              <svg viewBox="0 0 24 16" width="20" height="14" aria-hidden="true"><rect width="24" height="16" fill="#AA151B"/><rect y="4" width="24" height="8" fill="#F1BF00"/></svg>
              <span>Castellano</span>
            </div>
            <div class="lang-dropdown-option">
              <svg viewBox="0 0 24 16" width="20" height="14" aria-hidden="true"><rect width="24" height="16" fill="#FCDD09"/><rect y="1.14" width="24" height="1.14" fill="#DA121A"/><rect y="3.43" width="24" height="1.14" fill="#DA121A"/><rect y="5.71" width="24" height="1.14" fill="#DA121A"/><rect y="8" width="24" height="1.14" fill="#DA121A"/><rect y="10.29" width="24" height="1.14" fill="#DA121A"/><rect y="12.57" width="24" height="1.14" fill="#DA121A"/><rect y="14.86" width="24" height="1.14" fill="#DA121A"/></svg>
              <span>Català</span>
            </div>
            <div class="lang-dropdown-option">
              <svg viewBox="0 0 24 16" width="20" height="14" aria-hidden="true"><rect width="24" height="16" fill="#FCDD09"/><rect y="1.14" width="24" height="1.14" fill="#DA121A"/><rect y="3.43" width="24" height="1.14" fill="#DA121A"/><rect y="5.71" width="24" height="1.14" fill="#DA121A"/><rect y="8" width="24" height="1.14" fill="#DA121A"/><rect y="10.29" width="24" height="1.14" fill="#DA121A"/><rect y="12.57" width="24" height="1.14" fill="#DA121A"/><rect y="14.86" width="24" height="1.14" fill="#DA121A"/><polygon points="0,0 9,8 0,16" fill="#1E4C9A"/></svg>
              <span>Valencià</span>
            </div>
            <div class="lang-dropdown-option">
              <svg viewBox="0 0 24 16" width="20" height="14" aria-hidden="true"><rect width="24" height="16" fill="#FFFFFF"/><polygon points="0,0 8,0 24,16 16,16" fill="#0090C7"/></svg>
              <span>Galego</span>
            </div>
            <div class="lang-dropdown-option">
              <svg viewBox="0 0 24 16" width="20" height="14" aria-hidden="true"><rect width="24" height="16" fill="#D52B1E"/><polygon points="0,0 24,16 24,13 3,0" fill="#009B3A"/><polygon points="24,0 0,16 0,13 21,0" fill="#009B3A"/><rect x="10" width="4" height="16" fill="#FFFFFF"/><rect y="6" width="24" height="4" fill="#FFFFFF"/></svg>
              <span>Euskara</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="preview-caption on-dark">Recreación ilustrativa e interactiva de las opciones de color e idioma — no son capturas reales de la app.</p>
  </div>
</section>

<script>
  const sidebar = document.getElementById('colorSidebar');
  const swatchRow = document.getElementById('swatchRow');
  const body = document.getElementById('colorBody');
  const contentToggle = document.getElementById('contentToggle');
  const toneToggle = document.getElementById('toneToggle');
  const demoArea = document.getElementById('demoArea');
  const langDropdown = document.getElementById('langDropdown');
  const langDropdownBtn = document.getElementById('langDropdownBtn');
  const langDropdownPanel = document.getElementById('langDropdownPanel');
  const langChevron = document.getElementById('langChevron');
  const langDropdownLabel = document.getElementById('langDropdownLabel');
  // La sección de FAQ (más abajo en la página) comparte el mismo color de
  // fondo que este demo — están ligadas a propósito.
  const tintedSections = [
    document.getElementById('personalizacion'),
    document.getElementById('preguntas-frecuentes'),
  ].filter(Boolean);

  let currentKey = 'verde';
  let currentTone = 'dark';

  // Luminosidad relativa aproximada (0 = negro, 1 = blanco) para decidir si
  // el fondo elegido es "claro" u "oscuro" y así mantener el contraste de
  // los textos de la sección (que por defecto están pensados para fondo
  // oscuro).
  function isLightColor(hex) {
    const clean = hex.replace('#', '');
    const r = parseInt(clean.substring(0, 2), 16);
    const g = parseInt(clean.substring(2, 4), 16);
    const b = parseInt(clean.substring(4, 6), 16);
    const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
    return luminance > 0.6;
  }

  function applySidebar() {
    const btn = swatchRow?.querySelector(`.swatch[data-key="${currentKey}"]`);
    if (!btn || !sidebar) return;
    const bg = currentTone === 'dark' ? btn.dataset.bgDark : btn.dataset.bgLight;
    const fg = currentTone === 'dark' ? btn.dataset.fgDark : btn.dataset.fgLight;
    sidebar.style.background = bg;
    sidebar.style.setProperty('--sb-fg', fg);
    // El fondo de esta sección (y el de la sección de FAQ, ligada a ella)
    // acompaña al color elegido para la barra lateral, para que el ejemplo
    // se sienta más "en vivo". Si ese color es claro, se oscurecen los
    // textos (pensados para fondo oscuro) para que no pierdan contraste.
    if (bg) {
      const light = isLightColor(bg);
      tintedSections.forEach((el) => {
        el.style.background = bg;
        el.classList.toggle('is-light-bg', light);
      });
    }
  }

  function refreshSwatchSwatches() {
    swatchRow?.querySelectorAll('.swatch').forEach((btn) => {
      const bg = currentTone === 'dark' ? btn.dataset.bgDark : btn.dataset.bgLight;
      btn.style.background = bg;
    });
  }

  swatchRow?.querySelectorAll('.swatch').forEach((btn) => {
    btn.addEventListener('click', () => {
      swatchRow.querySelectorAll('.swatch').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      currentKey = btn.getAttribute('data-key') || currentKey;
      applySidebar();
    });
  });

  toneToggle?.querySelectorAll('.toggle-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      toneToggle.querySelectorAll('.toggle-option').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      currentTone = btn.getAttribute('data-tone') || currentTone;
      refreshSwatchSwatches();
      applySidebar();
    });
  });

  contentToggle?.querySelectorAll('.toggle-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      contentToggle.querySelectorAll('.toggle-option').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const mode = btn.getAttribute('data-mode');
      const isDark = mode === 'dark';
      demoArea?.classList.toggle('theme-dark', isDark);
    });
  });

  // Desplegable real de idioma (Castellano/Català) — abre/cierra de verdad y
  // la opción elegida actualiza el texto y la bandera del botón. Por defecto
  // arranca abierto (igual que en las capturas que pasó Miq), pero es 100%
  // funcional: clicar el botón lo cierra/abre, clicar una opción la
  // selecciona, clicar fuera o pulsar Escape lo cierra.
  function setLangOpen(open) {
    if (!langDropdownPanel || !langChevron || !langDropdownBtn || !langDropdown) return;
    langDropdownPanel.hidden = !open;
    langChevron.classList.toggle('open', open);
    langDropdownBtn.setAttribute('aria-expanded', String(open));
    langDropdown.classList.toggle('is-open', open);
  }

  langDropdownBtn?.addEventListener('click', () => {
    const isOpen = langDropdownBtn.getAttribute('aria-expanded') === 'true';
    setLangOpen(!isOpen);
  });

  langDropdown?.querySelectorAll('.lang-dropdown-option').forEach((opt) => {
    opt.addEventListener('click', () => {
      langDropdown.querySelectorAll('.lang-dropdown-option').forEach((o) => {
        o.classList.remove('active');
        o.setAttribute('aria-selected', 'false');
      });
      opt.classList.add('active');
      opt.setAttribute('aria-selected', 'true');
      const lang = opt.getAttribute('data-lang');
      const label = opt.getAttribute('data-label');
      if (langDropdownLabel && label) langDropdownLabel.textContent = label;
      langDropdown.querySelectorAll('.lang-flag').forEach((flag) => {
        flag.hidden = flag.getAttribute('data-flag') !== lang;
      });
      setLangOpen(false);
    });
  });

  // Ojo: a propósito NO se cierra al clicar fuera. El desplegable arranca
  // abierto (igual que en las capturas que pasó Miq, para que se vea de un
  // vistazo sin necesitar clic) y un listener de "clic fuera" lo cerraría de
  // inmediato con el primer clic en cualquier parte de la página (p. ej. al
  // aceptar el banner de cookies), anulando ese efecto. Sigue siendo 100%
  // interactivo: el botón lo abre/cierra, y Escape también lo cierra.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setLangOpen(false);
  });

  applySidebar();
</script>
