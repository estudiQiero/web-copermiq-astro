---
// Sección de precios, movida de la antigua página /precios a la home (antes
// de "Por qué Copermiq"), a petición de Miq del 2026-08-19: se elimina la
// página independiente y este bloque pasa a formar parte del scroll de la
// home, enlazado desde el menú como ancla (#precios). Precios definitivos
// (confirmados por Miq el 2026-08-20, ya no son provisionales):
// Pro 1,95€/mes o 19,95€/año, Premium 8,95€/mes o 95€/año (precios anuales
// comerciales, no un cálculo estricto de "X meses gratis" — por eso el
// toggle no lleva ninguna etiqueta de ahorro). El plan intermedio, que
// vivía como "Suscripción · nombre por definir", se llama ya de forma
// definitiva "Pro" (decidido por Miq el 2026-08-19). El identificador
// interno (key/plan de Stripe y Supabase) sigue siendo 'subscription' /
// 'suscripcion' — eso NO cambia, es dato de la app, solo cambia el nombre
// que se muestra. Sigue pendiente la lista definitiva de características
// de cada plan (ver el documento de arquitectura de facturación en el
// proyecto de Claude).
// Fondo gris oscuro (2026-08-23, a petición de Miq): `.pricing-hero` y
// `.plan-comparison` (en PlanComparison.astro) comparten el mismo fondo
// (token `--dark-gray`, ver global.css) para leerse como un único bloque
// "Planes". Las cápsulas de precio y la tabla comparativa ya llevan su
// propio fondo blanco opaco, así que solo se aclaró a blanco lo que queda
// directamente sobre el gris (eyebrow/título/intro y la nota final).
import PlanComparison from './PlanComparison.astro';

const APP_URL = 'https://app.copermiq.com';

const plans = [
  {
    key: 'free',
    name: 'Gratis',
    price: '0 €',
    period: 'para siempre',
    description: 'Lo esencial para empezar a facturar y controlar tus gastos. Sin sorpresas de cobros adicionales. Usa Copermiq tanto como quieras. ¡Barra libre!',
    features: [
      'Facturas y presupuestos ilimitados',
      'Registro de gastos con IVA e IRPF',
      'Panel con tus números al día',
      'Copia de seguridad manual',
    ],
    cta: { label: 'Usa Copermiq gratis', href: APP_URL, kind: 'link' },
  },
  {
    key: 'subscription',
    name: 'Pro',
    billing: {
      monthly: { amount: '1,95 €', period: 'al mes' },
      annual: { amount: '19,95 €', period: 'al año' },
    },
    description: 'Funciones avanzadas para cuando tu actividad crece. (Lista final de características aún por definir.)',
    features: [
      'Todo lo del plan Gratis',
      'Facturas periódicas / recurrentes',
      'Facturas sin pie de página',
      'Copias de seguridad automáticas',
      'Categorías de gastos personalizables',
    ],
    cta: { label: 'Mejorar a Pro', kind: 'checkout', plan: 'subscription' },
    highlight: true,
  },
  {
    key: 'premium',
    name: 'Premium',
    billing: {
      monthly: { amount: '8,95 €', period: 'al mes' },
      annual: { amount: '95 €', period: 'al año' },
    },
    description: 'Características exclusivas para quien quiere ir más allá. (Lista final de características aún por definir.)',
    features: [
      'Todo lo de Pro',
      'Personalización de la interfaz',
      'Libros registro (facturas emitidas y recibidas)',
      'Soporte prioritario',
    ],
    cta: { label: 'Mejorar a Premium', kind: 'checkout', plan: 'premium' },
  },
];
---

<section id="precios" class="pricing-hero">
  <div class="wrap section-head">
    <span class="eyebrow">Planes</span>
    <h2>Un plan para cada momento de tu negocio</h2>
    <p>Empieza gratis. Sube de plan cuando lo necesites, cancela cuando quieras — sin permanencia.</p>
  </div>

  <div class="billing-toggle-wrap">
    <div class="billing-toggle" role="group" aria-label="Frecuencia de pago">
      <button type="button" class="toggle-option is-active" data-billing="monthly">Mensual</button>
      <button type="button" class="toggle-option" data-billing="annual">Anual</button>
    </div>
  </div>

  <div class="wrap pricing-grid">
    {plans.map((plan) => (
      <div class:list={['pricing-card', { 'is-highlight': plan.highlight }]}>
        {plan.highlight && <span class="pricing-badge">Más popular</span>}
        <h3 class="pricing-name">{plan.name}</h3>
        <p class="pricing-desc">{plan.description}</p>
        <p class="pricing-price">
          {plan.billing ? (
            <>
              <span class="pricing-amount" data-monthly={plan.billing.monthly.amount} data-annual={plan.billing.annual.amount}>{plan.billing.monthly.amount}</span>
              <span class="pricing-period" data-monthly={plan.billing.monthly.period} data-annual={plan.billing.annual.period}>{plan.billing.monthly.period}</span>
            </>
          ) : (
            <>
              <span class="pricing-amount">{plan.price}</span>
              <span class="pricing-period">{plan.period}</span>
            </>
          )}
        </p>
        <ul class="pricing-features">
          {plan.features.map((f) => (
            <li>
              <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        {plan.cta.kind === 'link' ? (
          <a class="btn btn-ghost pricing-cta" href={plan.cta.href} target="_blank" rel="noopener">{plan.cta.label}</a>
        ) : (
          <button type="button" class="btn btn-primary pricing-cta" data-checkout-plan={plan.cta.plan}>{plan.cta.label}</button>
        )}
      </div>
    ))}
  </div>

  <p class="preview-caption pricing-note">
    Todos los planes de pago se gestionan y pueden cancelarse en cualquier momento, tanto desde la web como desde la app.
  </p>
</section>

<PlanComparison />

<!-- 2026-08-20: el acordeón de FAQs de precios que vivía aquí se trasladó
     entero a /preguntas-frecuentes (sección "Precios y suscripción",
     misma pregunta/respuesta) — aquí solo queda un botón que enlaza
     directamente a esa sección. -->
<section class="pricing-faq-cta">
  <div class="wrap">
    <p>¿Tienes dudas sobre precios, facturación o cómo funciona el pago?</p>
    <a class="btn btn-ghost" href="/preguntas-frecuentes#precios-y-suscripcion">FAQs de precios y facturación</a>
  </div>
</section>

<script>
  import { startCheckout } from '../lib/billing.js';

  // Toggle mensual / anual: solo cambia lo que se muestra en pantalla.
  // El checkout sigue enviando el plan (subscription/premium) sin distinguir
  // aún la frecuencia — pendiente de tener los precios anuales dados de
  // alta en Stripe para poder elegir el price id correcto.
  const billingButtons = document.querySelectorAll('.billing-toggle [data-billing]');

  function applyBilling(mode) {
    document.querySelectorAll('.pricing-amount[data-monthly]').forEach((el) => {
      el.textContent = mode === 'annual' ? el.getAttribute('data-annual') : el.getAttribute('data-monthly');
    });
    document.querySelectorAll('.pricing-period[data-monthly]').forEach((el) => {
      el.textContent = mode === 'annual' ? el.getAttribute('data-annual') : el.getAttribute('data-monthly');
    });
    billingButtons.forEach((btn) => {
      btn.classList.toggle('is-active', btn.getAttribute('data-billing') === mode);
    });
  }

  billingButtons.forEach((btn) => {
    btn.addEventListener('click', () => applyBilling(btn.getAttribute('data-billing')));
  });

  document.querySelectorAll('[data-checkout-plan]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const plan = btn.getAttribute('data-checkout-plan');
      const original = btn.textContent;
      try {
        btn.disabled = true;
        btn.textContent = 'Cargando…';
        await startCheckout(plan);
      } catch (err) {
        // Caso más probable: el usuario no ha iniciado sesión todavía.
        // Le abrimos el modal de acceso en vez de mostrar el error en crudo.
        const accountBtn = document.getElementById('account-toggle');
        if (accountBtn && !accountBtn.classList.contains('is-connected')) {
          accountBtn.click();
        } else {
          alert(err instanceof Error ? err.message : 'Ha ocurrido un error. Inténtalo de nuevo.');
        }
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });
</script>
