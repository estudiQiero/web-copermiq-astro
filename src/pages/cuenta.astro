---
// Perfil del usuario en la propia web. Página protegida en el cliente: si
// no hay sesión de Supabase, se redirige a la home.
//
// Si el usuario es admin (profiles.is_admin = true — columna compartida
// con la app desde el 2026-08-08), tiene el panel de administración: una
// tabla con TODOS los usuarios (ampliado el 2026-08-08), con buscador por
// email o nota, filtro por tipo de plan, cambio de plan a mano, aprobar
// cuentas pendientes y eliminar.
//
// Importante: estas acciones NO llaman a funciones nuevas de la web —
// llaman a admin-list-users / admin-set-plan / admin-activate-user /
// admin-delete-user, que ya existen y gestiona el lado de la app
// (confirmado el 2026-08-08 tras preguntarle explícitamente, para no
// repetir el incidente de reinventar algo que ya estaba hecho). Todavía
// no existe "desactivar" una cuenta ya aprobada — solo activar, o
// eliminarla del todo — así que ese botón no está aquí.
//
// 2026-08-21 (Miq) — layout de columna lateral fija: hasta ahora esta
// página era solo un saludo centrado, y no había ninguna forma rápida de
// llegar aquí (el icono de cuenta de la cabecera, con sesión iniciada,
// abría directamente la confirmación de "cerrar sesión"). Miq pidió, con
// una captura de la app como referencia: que el icono de cuenta lleve
// DIRECTAMENTE aquí (cambio en AuthModal.astro).
//
// 2026-08-28 (Miq) — se quita la columna lateral. El nombre de la cuenta y
// "Cerrar sesión" ya viven en la cabecera (icono de cuenta + nuevo icono de
// "power", ver Header.astro/AuthModal.astro), y la navegación entre
// secciones pasa al menú principal del sitio (también en la cabecera, solo
// con sesión iniciada): Administración (exclusivo del admin), Cuenta y
// Compras. Esta página ahora es un único panel de contenido con tres vistas
// que se muestran/ocultan según el hash de la URL (#admin/#cuenta/#compras,
// los mismos que enlaza el menú) — sin recarga si ya estás aquí.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Tu cuenta — Copermiq" description="Tu perfil en Copermiq." noindex>
  <Header />

  <main id="account-main" class="account-page" hidden>
    <div class="wrap">
      <div class="account-content">
        <div id="admin-panel" class="admin-panel" hidden>
          <h2 class="admin-panel-title">Usuarios</h2>
          <p class="admin-panel-note">
            Todos los usuarios de Copermiq. Cambiar el plan o aprobar una cuenta aquí hace exactamente lo mismo que en el panel de la app (llama a las mismas funciones). Falta "desactivar" una cuenta ya aprobada — todavía no existe ese mecanismo en ningún lado. Cada fila empieza bloqueada: usa el candado de la derecha y escribe el email de esa cuenta para poder editarla. La columna "2F Ok" se marca sola cuando el usuario confirma su alta por email; el admin puede forzarla a mano si el correo no le llegó.
          </p>

          <div class="admin-controls">
            <input
              type="search"
              id="admin-search"
              class="admin-search"
              placeholder="Buscar por email o nota…"
              autocomplete="off"
            />
            <div class="admin-filter-chips" role="group" aria-label="Filtrar por plan">
              <button type="button" class="admin-filter-chip" data-plan="gratis">Gratis</button>
              <button type="button" class="admin-filter-chip" data-plan="suscripcion">Pro</button>
              <button type="button" class="admin-filter-chip" data-plan="regalo">Regalo</button>
              <button type="button" class="admin-filter-chip" data-plan="premium">Premium</button>
            </div>
          </div>

          <p class="admin-action-message" id="admin-action-message"></p>

          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th data-sort="email">Usuario <span class="admin-sort-indicator"></span></th>
                  <th class="admin-col-center" title="Se marca sola cuando el usuario confirma su alta por email; el admin puede forzarla a mano si el correo no le llegó.">2F Ok</th>
                  <th>Nota</th>
                  <th data-sort="plan">Plan <span class="admin-sort-indicator"></span></th>
                  <th data-sort="amount">Importe <span class="admin-sort-indicator"></span></th>
                  <th data-sort="since">Desde <span class="admin-sort-indicator"></span></th>
                  <th data-sort="renews">Renueva <span class="admin-sort-indicator"></span></th>
                  <th class="admin-col-center"><span class="sr-only">Acciones</span></th>
                  <th class="admin-col-lock"><span class="sr-only">Bloqueo</span></th>
                </tr>
              </thead>
              <tbody id="admin-table-body">
                <tr><td colspan="9" class="admin-table-empty">Cargando…</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- "Cuenta": email + última conexión — sustituye al antiguo
             saludo/estado vacío genérico. -->
        <div id="cuenta-panel" class="account-info-panel" hidden>
          <h2 class="admin-panel-title">Cuenta</h2>
          <dl class="account-info-list">
            <div class="account-info-row">
              <dt>Email</dt>
              <dd id="cuenta-panel-email">—</dd>
            </div>
            <div class="account-info-row">
              <dt>Última conexión</dt>
              <dd id="cuenta-panel-last-login">—</dd>
            </div>
          </dl>
        </div>

        <!-- "Compras": de momento no hay nada que mostrar (no hay todavía
             compra de plantillas ni Stripe activo en la web). -->
        <div id="compras-panel" class="account-info-panel" hidden>
          <h2 class="admin-panel-title">Compras</h2>
          <p class="account-empty-state">Todavía no has comprado nada.</p>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <!-- Confirmación de eliminar cuenta (reutiliza el patrón de auth-overlay/logout-modal) -->
  <div id="delete-user-overlay" class="auth-overlay" hidden>
    <div class="auth-modal logout-modal" role="dialog" aria-modal="true" aria-labelledby="delete-user-title">
      <button type="button" id="delete-user-close" class="auth-close" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <h3 id="delete-user-title" class="auth-heading">Eliminar cuenta</h3>
      <p class="logout-text" id="delete-user-text">¿Seguro que quieres eliminar esta cuenta? Se borran sus datos y su acceso, y no se puede deshacer.</p>
      <div class="logout-actions">
        <button type="button" id="delete-user-cancel" class="btn btn-ghost">Cancelar</button>
        <button type="button" id="delete-user-confirm" class="btn btn-primary">Eliminar</button>
      </div>
    </div>
  </div>

  <!-- Desbloqueo de una fila de usuario (candado): pide el email de ESA
       cuenta como confirmación de que es la correcta antes de dejar tocar
       nota/plan/confirmado/acciones de la fila. Un único modal compartido
       para todas las filas (como el de eliminar), en vez de uno por fila. -->
  <div id="row-unlock-overlay" class="auth-overlay" hidden>
    <div class="auth-modal logout-modal" role="dialog" aria-modal="true" aria-labelledby="row-unlock-title">
      <button type="button" id="row-unlock-close" class="auth-close" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <h3 id="row-unlock-title" class="auth-heading">Desbloquear cuenta</h3>
      <p class="logout-text" id="row-unlock-text">Escribe el email de esta cuenta para confirmar que es la que quieres editar.</p>
      <form class="auth-form" id="row-unlock-form">
        <label>
          Email de la cuenta
          <input type="email" id="row-unlock-input" autocomplete="off" placeholder="nombre@ejemplo.com" />
        </label>
      </form>
      <p class="row-unlock-error" id="row-unlock-error" hidden>El email no coincide con esta cuenta.</p>
      <div class="logout-actions">
        <button type="button" id="row-unlock-cancel" class="btn btn-ghost">Cancelar</button>
        <button type="button" id="row-unlock-confirm" class="btn btn-primary">Desbloquear</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabaseClient.js';
  import {
    getMyProfile,
    getAdminUsersList,
    getAdminBillingOverview,
    adminSetPlan,
    adminActivateUser,
    adminDeleteUser,
    getAdminUserNotes,
    saveAdminUserNote,
    adminSetEmailConfirmed,
  } from '../lib/billing.js';

  const main = document.getElementById('account-main');
  const adminPanel = document.getElementById('admin-panel');
  const cuentaPanel = document.getElementById('cuenta-panel');
  const comprasPanel = document.getElementById('compras-panel');
  const cuentaPanelEmail = document.getElementById('cuenta-panel-email');
  const cuentaPanelLastLogin = document.getElementById('cuenta-panel-last-login');
  const tableBody = document.getElementById('admin-table-body');
  const searchInput = document.getElementById('admin-search');
  const filterChips = Array.from(document.querySelectorAll('.admin-filter-chip'));
  const actionMessage = document.getElementById('admin-action-message');

  const deleteOverlay = document.getElementById('delete-user-overlay');
  const deleteText = document.getElementById('delete-user-text');
  const deleteCloseBtn = document.getElementById('delete-user-close');
  const deleteCancelBtn = document.getElementById('delete-user-cancel');
  const deleteConfirmBtn = document.getElementById('delete-user-confirm');

  // Candado por fila: pide el email de la cuenta como confirmación antes
  // de dejar tocar nota/plan/confirmado/acciones de esa fila. Un único
  // modal compartido para todas las filas (como el de eliminar) — no es
  // reautenticación del admin, solo "confirma que es esta cuenta" (ver
  // conversación 2026-08-28 con Miq: pidió explícitamente esto, no el
  // patrón de contraseña de admin + captcha que usa la app para sus
  // propios candados de sección).
  const unlockOverlay = document.getElementById('row-unlock-overlay');
  const unlockText = document.getElementById('row-unlock-text');
  const unlockInput = document.getElementById('row-unlock-input');
  const unlockError = document.getElementById('row-unlock-error');
  const unlockCloseBtn = document.getElementById('row-unlock-close');
  const unlockCancelBtn = document.getElementById('row-unlock-cancel');
  const unlockConfirmBtn = document.getElementById('row-unlock-confirm');

  // Valores reales de profiles.plan (verificado en Supabase, confirmado
  // por el lado de la app): español, no inglés — 'gratis' es el valor
  // por defecto. 'regalo' da el mismo acceso que 'suscripcion' pero sin
  // pago real (asignado a mano por un admin), añadido el 2026-08-08.
  // 'suscripcion' es el valor real en la base de datos (no cambia); "Pro"
  // es solo la etiqueta que se muestra, para que coincida con el nombre
  // público del plan (renombrado el 2026-08-19).
  const PLAN_LABELS = { gratis: 'Gratis', suscripcion: 'Pro', regalo: 'Regalo', premium: 'Premium' };

  // Icono "trash-can" de Font Awesome Free (solid), incrustado como SVG
  // en vez de cargar la fuente de iconos entera solo para este botón —
  // mismo criterio que ya se usa para el icono de cerrar del modal.
  const TRASH_ICON_SVG = '<svg viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M135.2 17.7C140.6 6.8 151.7 0 163.8 0L284.2 0c12.1 0 23.2 6.8 28.6 17.7L320 32l96 0c17.7 0 32 14.3 32 32s-14.3 32-32 32L32 96C14.3 96 0 81.7 0 64S14.3 32 32 32l96 0 7.2-14.3zM32 128l384 0 0 320c0 35.3-28.7 64-64 64L96 512c-35.3 0-64-28.7-64-64L32 128zm96 64c-8.8 0-16 7.2-16 16l0 224c0 8.8 7.2 16 16 16s16-7.2 16-16l0-224c0-8.8-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16l0 224c0 8.8 7.2 16 16 16s16-7.2 16-16l0-224c0-8.8-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16l0 224c0 8.8 7.2 16 16 16s16-7.2 16-16l0-224c0-8.8-7.2-16-16-16z"/></svg>';

  // Candado cerrado/abierto (mismo trazo que el resto de iconos en línea
  // fina del sitio).
  const ICON_LOCK_CLOSED = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2.2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>';
  const ICON_LOCK_OPEN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2.2"/><path d="M8 11V7a4 4 0 0 1 7.5-2.2"/></svg>';

  let allRows = [];
  let currentUserId = null;
  // Solo una fila puede estar desbloqueada a la vez ("la cuenta activa
  // tendrá su color natural", singular — Miq, 2026-08-28): desbloquear
  // otra fila vuelve a bloquear la anterior automáticamente.
  let unlockedUserId = null;
  let pendingUnlock = null; // { userId, email } mientras el modal de desbloqueo está abierto
  let currentUserIsAdmin = false;
  let pendingDelete = null; // { userId, email } mientras el modal de borrado está abierto
  let sortState = { key: null, dir: 'asc' }; // ordenación al hacer clic en un título de columna

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
    ));
  }

  function formatDate(value) {
    return value ? new Date(value).toLocaleDateString('es-ES') : '—';
  }

  function activeFilters() {
    return filterChips.filter((chip) => chip.classList.contains('is-active')).map((chip) => chip.dataset.plan);
  }

  function setActionMessage(text, isError) {
    if (!actionMessage) return;
    actionMessage.textContent = text ?? '';
    actionMessage.classList.toggle('error', Boolean(isError));
  }

  // Valor "ordenable" de una fila para cada columna con data-sort. Plan se
  // ordena por su etiqueta visible (no por el valor interno), para que el
  // orden alfabético coincida con lo que se ve en pantalla.
  function sortValue(row, key) {
    switch (key) {
      case 'email':
        return (row.email ?? '').toLowerCase();
      case 'plan':
        return (PLAN_LABELS[row.plan] ?? row.plan ?? '').toLowerCase();
      case 'amount':
        return row.amount ?? null;
      case 'since':
        return row.planSince ?? row.createdAt ?? null;
      case 'renews':
        return row.currentPeriodEnd ?? null;
      default:
        return null;
    }
  }

  function isEmptyValue(value) {
    return value === null || value === undefined || value === '';
  }

  // Los valores ausentes ("—" en la tabla) siempre van al final, tanto en
  // ascendente como en descendente — si no, "ascendente" pondría todos
  // los "—" primero, que confunde más de lo que ayuda.
  function compareRows(a, b, key, dir) {
    const va = sortValue(a, key);
    const vb = sortValue(b, key);
    const aEmpty = isEmptyValue(va);
    const bEmpty = isEmptyValue(vb);
    if (aEmpty && bEmpty) return 0;
    if (aEmpty) return 1;
    if (bEmpty) return -1;

    let cmp;
    if (key === 'since' || key === 'renews') {
      cmp = new Date(va).getTime() - new Date(vb).getTime();
    } else if (typeof va === 'number' && typeof vb === 'number') {
      cmp = va - vb;
    } else {
      cmp = String(va).localeCompare(String(vb), 'es');
    }
    return dir === 'asc' ? cmp : -cmp;
  }

  function updateSortIndicators() {
    document.querySelectorAll('.admin-table th[data-sort]').forEach((th) => {
      const indicator = th.querySelector('.admin-sort-indicator');
      if (!indicator) return;
      indicator.textContent = th.dataset.sort === sortState.key ? (sortState.dir === 'asc' ? '▲' : '▼') : '';
    });
  }

  document.querySelectorAll('.admin-table th[data-sort]').forEach((th) => {
    th.addEventListener('click', () => {
      const key = th.dataset.sort;
      sortState = sortState.key === key
        ? { key, dir: sortState.dir === 'asc' ? 'desc' : 'asc' }
        : { key, dir: 'asc' };
      updateSortIndicators();
      renderTable();
    });
  });

  function renderTable() {
    if (!tableBody) return;

    const filters = activeFilters();
    const search = (searchInput instanceof HTMLInputElement ? searchInput.value : '').trim().toLowerCase();

    const rows = allRows.filter((row) => {
      if (filters.length && !filters.includes(row.plan)) return false;
      if (search) {
        const inEmail = (row.email ?? '').toLowerCase().includes(search);
        const inNote = (row.note ?? '').toLowerCase().includes(search);
        if (!inEmail && !inNote) return false;
      }
      return true;
    });

    if (sortState.key) {
      rows.sort((a, b) => compareRows(a, b, sortState.key, sortState.dir));
    }

    if (!rows.length) {
      tableBody.innerHTML = '<tr><td colspan="9" class="admin-table-empty">No hay usuarios que coincidan con la búsqueda/filtro.</td></tr>';
      return;
    }

    tableBody.innerHTML = rows.map((row) => {
      // Importe y Renueva: cuando no hay un dato real que mostrar, el
      // guion "—" queda centrado en su columna en vez de pegado a la
      // izquierda (a petición de Miq, 2026-08-28) — solo en esos dos
      // huecos, no en el resto de columnas que también pueden mostrar "—"
      // (Desde no se toca).
      const amountLabel = row.amount != null
        ? `${row.amount.toFixed(2)} ${(row.currency ?? '').toUpperCase()} / ${row.interval === 'year' ? 'año' : 'mes'}`
        : '—';
      const amountClass = row.amount != null ? '' : 'admin-col-center';
      const renewsLabel = formatDate(row.currentPeriodEnd);
      const renewsClass = row.currentPeriodEnd ? '' : 'admin-col-center';
      // "Desde": la fecha desde la que tiene el plan actual si la
      // tenemos (viene de admin-billing-overview, solo para planes de
      // pago/regalo); si no, la fecha de alta de la cuenta.
      const sinceLabel = formatDate(row.planSince ?? row.createdAt);
      const planOptions = Object.entries(PLAN_LABELS).map(([value, label]) => (
        `<option value="${value}" ${row.plan === value ? 'selected' : ''}>${escapeHtml(label)}</option>`
      )).join('');
      const isSelf = row.userId === currentUserId;
      // admin-list-users no devuelve is_admin por usuario (solo lo sabemos
      // de nuestra propia fila, vía getMyProfile) — así que la píldora
      // cian de "Admin" solo se puede aplicar con seguridad a la fila del
      // propio admin logueado; el resto se colorea por su plan real.
      const planClass = (isSelf && currentUserIsAdmin) ? 'admin-plan-select--admin' : `admin-plan-select--${row.plan}`;

      // Candado: todas las filas empiezan bloqueadas: solo la fila
      // desbloqueada (unlockedUserId) queda con su color normal e
      // interactiva — el resto se atenúa y queda inerte (ver .is-locked
      // en global.css). El propio botón de candado NUNCA se desactiva,
      // para poder volver a desbloquear.
      const locked = row.userId !== unlockedUserId;
      const disabledAttr = locked ? 'disabled' : '';
      // "2F Ok" (confirmado por email): dato real desde el 2026-08-28 —
      // ver getAdminUsersList() en billing.js. Igual que el resto de
      // controles de la fila, solo se puede tocar con el candado
      // desbloqueado; el admin lo fuerza a mano llamando a
      // admin-set-email-confirmed (para cuando el email real no llega:
      // spam, error del usuario…).
      const confirmedChecked = row.emailConfirmed ? 'checked' : '';

      return `
        <tr class="admin-row ${locked ? 'is-locked' : ''}">
          <td>${escapeHtml(row.email ?? '—')}${row.approved === false ? ' <span class="admin-badge admin-badge-pending">Pendiente</span>' : ''}</td>
          <td class="admin-col-center">
            <input
              type="checkbox"
              class="admin-confirmed-checkbox"
              data-user-id="${escapeHtml(row.userId ?? '')}"
              ${confirmedChecked}
              ${disabledAttr}
              title="Cuenta confirmada por email — el admin puede forzarla a mano si el correo de confirmación no llegó"
            />
          </td>
          <td>
            <input
              type="text"
              class="admin-note-input"
              data-user-id="${escapeHtml(row.userId ?? '')}"
              value="${escapeHtml(row.note ?? '')}"
              title="${escapeHtml(row.note ?? '')}"
              placeholder="Nota…"
              ${disabledAttr}
            />
          </td>
          <td>
            <select class="admin-plan-select ${planClass}" data-user-id="${escapeHtml(row.userId ?? '')}" ${isSelf ? 'disabled' : disabledAttr}>
              ${planOptions}
            </select>
          </td>
          <td class="${amountClass}">${escapeHtml(amountLabel)}</td>
          <td>${sinceLabel}</td>
          <td class="${renewsClass}">${renewsLabel}</td>
          <td>
            <div class="admin-table-actions">
              ${row.approved === false
                ? `<button type="button" class="admin-approve-btn" data-user-id="${escapeHtml(row.userId ?? '')}" ${disabledAttr}>Aprobar</button>`
                : ''}
              <button
                type="button"
                class="admin-delete-btn"
                data-user-id="${escapeHtml(row.userId ?? '')}"
                data-email="${escapeHtml(row.email ?? '')}"
                aria-label="Eliminar cuenta"
                ${isSelf ? 'disabled title="No puedes eliminarte a ti mismo desde aquí"' : `${disabledAttr} title="Eliminar cuenta"`}
              >${TRASH_ICON_SVG}</button>
            </div>
          </td>
          <td class="admin-col-lock">
            <button
              type="button"
              class="lock-btn"
              data-user-id="${escapeHtml(row.userId ?? '')}"
              data-email="${escapeHtml(row.email ?? '')}"
              aria-label="${locked ? 'Bloqueado — pulsa para desbloquear' : 'Desbloqueado — pulsa para bloquear'}"
              title="${locked ? 'Bloqueado — pulsa para desbloquear' : 'Desbloqueado — pulsa para bloquear'}"
            >${locked ? ICON_LOCK_CLOSED : ICON_LOCK_OPEN}</button>
          </td>
        </tr>
      `;
    }).join('');
  }

  async function loadAdminTable() {
    if (!tableBody) return;
    tableBody.innerHTML = '<tr><td colspan="9" class="admin-table-empty">Cargando…</td></tr>';
    try {
      // Tres llamadas: la lista completa de usuarios (admin-list-users,
      // de la app), el detalle de Stripe para los de pago/regalo
      // (admin-billing-overview, de la web) — se cruzan por email, ya que
      // admin-billing-overview no devuelve user_id — y las notas propias
      // de la web (admin_user_notes), que se cruzan por user_id.
      const [users, billing, notes] = await Promise.all([
        getAdminUsersList(),
        getAdminBillingOverview().catch((err) => {
          console.warn('[Copermiq] No se pudo cargar el detalle de Stripe:', err);
          return [];
        }),
        getAdminUserNotes(),
      ]);
      const billingByEmail = new Map(billing.map((row) => [row.email, row]));
      const noteByUserId = new Map(notes.map((row) => [row.userId, row.note]));
      allRows = users.map((user) => {
        const detail = billingByEmail.get(user.email);
        const note = noteByUserId.get(user.userId) ?? '';
        return detail ? { ...user, ...detail, userId: user.userId, note } : { ...user, note };
      });
      renderTable();
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Error cargando los datos.';
      tableBody.innerHTML = `<tr><td colspan="9" class="admin-table-empty">${escapeHtml(msg)}</td></tr>`;
    }
  }

  // Cambiar el plan de un usuario a mano — delegación de eventos porque
  // las filas se regeneran en cada render.
  // Guardar una nota — a diferencia de las demás acciones, NO recarga ni
  // vuelve a pintar la tabla entera: eso movería el foco y perdería lo
  // que se esté escribiendo en otra fila. Solo actualiza allRows en
  // memoria para que un futuro renderTable() (por búsqueda/filtro/orden)
  // no pierda el valor guardado.
  tableBody?.addEventListener('change', async (event) => {
    const noteTarget = event.target;
    if (noteTarget instanceof HTMLInputElement && noteTarget.classList.contains('admin-note-input')) {
      const userId = noteTarget.dataset.userId;
      if (!userId) return;
      const note = noteTarget.value;
      try {
        await saveAdminUserNote(userId, note);
        const row = allRows.find((r) => r.userId === userId);
        if (row) row.note = note;
        noteTarget.title = note;
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'No se pudo guardar la nota.';
        setActionMessage(msg, true);
      }
      return;
    }

    // "2F Ok": igual que la nota, se actualiza en memoria sin recargar ni
    // repintar la tabla entera (no perder lo que se esté editando en otra
    // fila) — pero si la llamada falla, el checkbox vuelve a su estado
    // anterior para no mentir sobre lo que de verdad quedó guardado.
    const confirmedTarget = event.target;
    if (confirmedTarget instanceof HTMLInputElement && confirmedTarget.classList.contains('admin-confirmed-checkbox')) {
      const userId = confirmedTarget.dataset.userId;
      if (!userId) return;
      const confirmed = confirmedTarget.checked;
      confirmedTarget.disabled = true;
      try {
        await adminSetEmailConfirmed(userId, confirmed);
        const row = allRows.find((r) => r.userId === userId);
        if (row) row.emailConfirmed = confirmed;
      } catch (err) {
        confirmedTarget.checked = !confirmed;
        const msg = err instanceof Error ? err.message : 'No se pudo actualizar "2F Ok".';
        setActionMessage(msg, true);
      } finally {
        confirmedTarget.disabled = false;
      }
      return;
    }

    const target = event.target;
    if (!(target instanceof HTMLSelectElement) || !target.classList.contains('admin-plan-select')) return;
    const userId = target.dataset.userId;
    const plan = target.value;
    if (!userId) return;

    target.disabled = true;
    setActionMessage('Guardando…', false);
    try {
      await adminSetPlan(userId, plan);
      setActionMessage('Plan actualizado.', false);
      await loadAdminTable();
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'No se pudo cambiar el plan.';
      setActionMessage(msg, true);
      target.disabled = false;
    }
  });

  // Aprobar una cuenta pendiente.
  tableBody?.addEventListener('click', async (event) => {
    const target = event.target;
    // Element, no HTMLElement: si el clic cae sobre el <svg>/<path> del
    // icono (candado o papelera), el target es un SVGElement, que NO es
    // instancia de HTMLElement — con ese guard el listener cortaba aquí
    // mismo y closest('.lock-btn') no llegaba a ejecutarse nunca. Element
    // es la clase común a ambos y basta para todo lo que sigue (classList,
    // dataset y closest funcionan igual en SVGElement).
    if (!(target instanceof Element)) return;

    if (target.classList.contains('admin-approve-btn')) {
      const userId = target.dataset.userId;
      if (!userId || !(target instanceof HTMLButtonElement)) return;
      target.disabled = true;
      setActionMessage('Aprobando…', false);
      try {
        await adminActivateUser(userId);
        setActionMessage('Cuenta aprobada.', false);
        await loadAdminTable();
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'No se pudo aprobar la cuenta.';
        setActionMessage(msg, true);
        target.disabled = false;
      }
      return;
    }

    const deleteBtn = target.closest('.admin-delete-btn');
    if (deleteBtn instanceof HTMLElement) {
      const userId = deleteBtn.dataset.userId;
      const email = deleteBtn.dataset.email;
      if (!userId) return;
      pendingDelete = { userId, email: email ?? '' };
      if (deleteText) deleteText.textContent = `¿Seguro que quieres eliminar la cuenta de ${email}? Se borran sus datos y su acceso, y no se puede deshacer.`;
      if (deleteOverlay instanceof HTMLElement) deleteOverlay.hidden = false;
      return;
    }

    // Candado de la fila: `target` puede ser el propio <svg>/<path> del
    // icono (el click "atraviesa" hasta el SVG interior del botón), así
    // que se busca el botón con closest() en vez de mirar target directo.
    const lockBtn = target.closest('.lock-btn');
    if (lockBtn instanceof HTMLElement) {
      const userId = lockBtn.dataset.userId;
      if (!userId) return;
      if (userId === unlockedUserId) {
        // Ya estaba desbloqueada esta fila: el propio candado la vuelve a
        // bloquear directamente, sin pedir nada de nuevo.
        unlockedUserId = null;
        renderTable();
        return;
      }
      pendingUnlock = { userId, email: lockBtn.dataset.email ?? '' };
      if (unlockText) unlockText.textContent = `Escribe el email de "${lockBtn.dataset.email ?? ''}" para confirmar que es la cuenta que quieres editar.`;
      if (unlockInput instanceof HTMLInputElement) unlockInput.value = '';
      if (unlockError instanceof HTMLElement) unlockError.hidden = true;
      if (unlockOverlay instanceof HTMLElement) unlockOverlay.hidden = false;
      unlockInput?.focus();
    }
  });

  function closeDeleteModal() {
    pendingDelete = null;
    if (deleteOverlay instanceof HTMLElement) deleteOverlay.hidden = true;
  }
  deleteCloseBtn?.addEventListener('click', closeDeleteModal);
  deleteCancelBtn?.addEventListener('click', closeDeleteModal);
  deleteOverlay?.addEventListener('click', (event) => {
    if (event.target === deleteOverlay) closeDeleteModal();
  });

  deleteConfirmBtn?.addEventListener('click', async () => {
    if (!pendingDelete) return;
    const { userId, email } = pendingDelete;
    if (deleteConfirmBtn instanceof HTMLButtonElement) deleteConfirmBtn.disabled = true;
    setActionMessage('Eliminando…', false);
    try {
      await adminDeleteUser(userId, email);
      setActionMessage(`Cuenta de ${email} eliminada.`, false);
      closeDeleteModal();
      await loadAdminTable();
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'No se pudo eliminar la cuenta.';
      setActionMessage(msg, true);
    } finally {
      if (deleteConfirmBtn instanceof HTMLButtonElement) deleteConfirmBtn.disabled = false;
    }
  });

  function closeUnlockModal() {
    pendingUnlock = null;
    if (unlockOverlay instanceof HTMLElement) unlockOverlay.hidden = true;
  }
  unlockCloseBtn?.addEventListener('click', closeUnlockModal);
  unlockCancelBtn?.addEventListener('click', closeUnlockModal);
  unlockOverlay?.addEventListener('click', (event) => {
    if (event.target === unlockOverlay) closeUnlockModal();
  });

  function confirmUnlock() {
    if (!pendingUnlock || !(unlockInput instanceof HTMLInputElement)) return;
    const typed = unlockInput.value.trim().toLowerCase();
    const real = (pendingUnlock.email ?? '').trim().toLowerCase();
    if (!typed || typed !== real) {
      if (unlockError instanceof HTMLElement) unlockError.hidden = false;
      return;
    }
    unlockedUserId = pendingUnlock.userId;
    closeUnlockModal();
    renderTable();
  }
  unlockConfirmBtn?.addEventListener('click', confirmUnlock);
  unlockInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      confirmUnlock();
    }
  });
  unlockInput?.addEventListener('input', () => {
    if (unlockError instanceof HTMLElement) unlockError.hidden = true;
  });

  searchInput?.addEventListener('input', renderTable);
  filterChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chip.classList.toggle('is-active');
      renderTable();
    });
  });

  // 2026-08-28: qué sección se ve depende del hash de la URL (#admin,
  // #cuenta, #compras) — los mismos que enlaza el nuevo menú principal de
  // la cabecera (ver Header.astro). Si no hay hash, o no es válido, o pide
  // #admin sin ser admin, cae a la sección por defecto: Administración para
  // el admin, Cuenta para el resto — así una cuenta normal que entra
  // directamente en /cuenta (sin pasar por el menú) sigue viendo algo útil.
  const VALID_PANELS = ['admin', 'cuenta', 'compras'];

  function currentPanelFromHash() {
    const hash = (window.location.hash || '').replace('#', '');
    return VALID_PANELS.includes(hash) ? hash : null;
  }

  function showPanel(name) {
    const target = (name === 'admin' && !currentUserIsAdmin) ? 'cuenta' : name;
    if (adminPanel instanceof HTMLElement) adminPanel.hidden = target !== 'admin';
    if (cuentaPanel instanceof HTMLElement) cuentaPanel.hidden = target !== 'cuenta';
    if (comprasPanel instanceof HTMLElement) comprasPanel.hidden = target !== 'compras';
  }

  function formatDateTime(value) {
    return value ? new Date(value).toLocaleString('es-ES') : '—';
  }

  async function loadAccount() {
    const { data: sessionData } = await supabase.auth.getSession();
    const user = sessionData.session?.user;
    currentUserId = user?.id ?? null;
    if (cuentaPanelEmail) cuentaPanelEmail.textContent = user?.email ?? '—';
    // last_sign_in_at lo mantiene Supabase Auth en cada inicio de sesión,
    // sea desde la web o desde la app (mismo backend) — así que ya refleja
    // "la última vez que nos conectamos" sin importar por dónde fue.
    if (cuentaPanelLastLogin) cuentaPanelLastLogin.textContent = formatDateTime(user?.last_sign_in_at);

    // profiles.is_admin: columna compartida con la app desde el
    // 2026-08-08 (antes no existía ningún criterio común, por eso este
    // panel estuvo desactivado un tiempo). Ver copermiq-billing-architecture.md.
    const profile = await getMyProfile();
    if (profile?.is_admin) {
      currentUserIsAdmin = true;
      loadAdminTable();
    }
    showPanel(currentPanelFromHash() ?? (currentUserIsAdmin ? 'admin' : 'cuenta'));
  }

  // Si ya estamos en /cuenta y se pincha otro item del menú principal de la
  // cabecera (mismo enlace con distinto hash), no hay recarga — solo cambia
  // el hash — así que hace falta escuchar el cambio a mano.
  window.addEventListener('hashchange', () => {
    showPanel(currentPanelFromHash() ?? (currentUserIsAdmin ? 'admin' : 'cuenta'));
  });

  async function guard() {
    if (!supabase) {
      // Sin claves de Supabase configuradas no podemos comprobar la sesión;
      // no bloqueamos la página para no dejarla inaccesible en desarrollo.
      if (main instanceof HTMLElement) main.hidden = false;
      return;
    }
    const { data } = await supabase.auth.getSession();
    if (!data.session) {
      window.location.href = '/';
      return;
    }
    if (main instanceof HTMLElement) main.hidden = false;
    loadAccount();
  }

  guard();
</script>
