---
// Perfil del usuario en la propia web. Página protegida en el cliente: si
// no hay sesión de Supabase, se redirige a la home.
//
// De momento solo hay un saludo con el email y, si el usuario es admin
// (profiles.role = 'admin'), el panel de administración: una píldora
// "Admin" (igual que las de la app Copermiq) y debajo una tabla con las
// suscripciones/pagos de Stripe de todos los usuarios. Es un primer punto
// de partida — el diseño y el resto de pestañas (panel de control por
// usuario) se harán más adelante.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Tu cuenta — Copermiq" description="Tu perfil en Copermiq.">
  <Header />

  <main id="account-main" class="account-page" hidden>
    <div class="wrap">
      <div class="account-welcome">
        <p class="account-welcome-label">Tu cuenta</p>
        <p class="account-welcome-email" id="account-email">—</p>
      </div>

      <div id="admin-panel" class="admin-panel" hidden>
        <div class="account-tabs" role="tablist" aria-label="Secciones de administración">
          <button type="button" class="account-tab is-active" data-admin-tab="admin" role="tab" aria-selected="true">Admin</button>
        </div>

        <div class="admin-panel-body">
          <h2 class="admin-panel-title">Suscripciones y pagos</h2>
          <p class="admin-panel-note">
            Datos en vivo desde Stripe. Punto de partida — faltan devoluciones, histórico de pagos sueltos y el panel de control por usuario individual.
          </p>

          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Usuario</th>
                  <th>Plan</th>
                  <th>Estado</th>
                  <th>Importe</th>
                  <th>Renueva / termina</th>
                </tr>
              </thead>
              <tbody id="admin-table-body">
                <tr><td colspan="5" class="admin-table-empty">Cargando…</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabaseClient.js';
  import { getMyProfile, getAdminBillingOverview } from '../lib/billing.js';

  const main = document.getElementById('account-main');
  const emailEl = document.getElementById('account-email');
  const adminPanel = document.getElementById('admin-panel');
  const tableBody = document.getElementById('admin-table-body');

  const PLAN_LABELS = { free: 'Gratis', subscription: 'Suscripción', premium: 'Premium' };
  const STRIPE_STATUS_LABELS = {
    active: 'Activa',
    trialing: 'En prueba',
    past_due: 'Pago fallido',
    canceled: 'Cancelada',
    incomplete: 'Incompleta',
    incomplete_expired: 'Incompleta (caducada)',
    unpaid: 'Impagada',
    paused: 'Pausada',
  };

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
    ));
  }

  async function loadAdminTable() {
    if (!tableBody) return;
    try {
      const rows = await getAdminBillingOverview();
      if (!rows.length) {
        tableBody.innerHTML = '<tr><td colspan="5" class="admin-table-empty">Todavía no hay suscripciones de pago.</td></tr>';
        return;
      }
      tableBody.innerHTML = rows.map((row) => `
        <tr>
          <td>${escapeHtml(row.customerEmail ?? '—')}</td>
          <td>${escapeHtml(PLAN_LABELS[row.plan] ?? row.plan ?? '—')}</td>
          <td>${escapeHtml(STRIPE_STATUS_LABELS[row.stripeStatus] ?? row.stripeStatus ?? '—')}${row.cancelAtPeriodEnd ? ' (cancela)' : ''}</td>
          <td>${row.amount != null ? `${row.amount.toFixed(2)} ${(row.currency ?? '').toUpperCase()} / ${row.interval === 'year' ? 'año' : 'mes'}` : '—'}</td>
          <td>${row.currentPeriodEnd ? new Date(row.currentPeriodEnd).toLocaleDateString('es-ES') : '—'}</td>
        </tr>
      `).join('');
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Error cargando los datos.';
      tableBody.innerHTML = `<tr><td colspan="5" class="admin-table-empty">${escapeHtml(msg)}</td></tr>`;
    }
  }

  async function loadAccount() {
    const { data: sessionData } = await supabase.auth.getSession();
    if (emailEl) emailEl.textContent = sessionData.session?.user?.email ?? '';

    const profile = await getMyProfile();
    if (profile?.role === 'admin') {
      if (adminPanel instanceof HTMLElement) adminPanel.hidden = false;
      loadAdminTable();
    }
  }

  async function guard() {
    if (!supabase) {
      // Sin claves de Supabase configuradas no podemos comprobar la sesión;
      // no bloqueamos la página para no dejarla inaccesible en desarrollo.
      if (main instanceof HTMLElement) main.hidden = false;
      return;
    }
    const { data } = await supabase.auth.getSession();
    if (!data.session) {
      window.location.href = '/';
      return;
    }
    if (main instanceof HTMLElement) main.hidden = false;
    loadAccount();
  }

  guard();
</script>
