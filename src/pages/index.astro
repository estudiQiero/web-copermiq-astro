---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HeroCta from '../components/HeroCta.astro';
import WhyCopermiq from '../components/WhyCopermiq.astro';
import Features from '../components/Features.astro';
import PlanHighlight from '../components/PlanHighlight.astro';
import Customization from '../components/Customization.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ProductPreview from '../components/ProductPreview.astro';
import Security from '../components/Security.astro';
import FinalCta from '../components/FinalCta.astro';
import Pricing from '../components/Pricing.astro';
import Footer from '../components/Footer.astro';
// FAQ.astro ya no se usa aquí — 2026-08-20: toda su FAQ (y la de precios,
// antes en Pricing.astro) se trasladó a la página /preguntas-frecuentes.
// El componente se queda en el repo sin importar por si hace falta
// recuperar algo puntual; Miq puede borrarlo cuando quiera.
---

<!-- Orden 2026-08-23 (tercera ronda): Miq pidió que "Empieza hoy" (FinalCta)
     vaya "justo después del hero". HeroCta comparte fondo navy con Hero sin
     separación visual entre ambas (ver comentario de HeroCta.astro) — se
     interpreta como un único bloque "hero", así que FinalCta se coloca justo
     después de ese bloque completo (Hero + HeroCta), antes de Features. Si
     Miq quería decir literalmente entre Hero y HeroCta, avisar para
     moverlo. -->
<Layout>
  <Header />
  <Hero />
  <HeroCta />
  <FinalCta />
  <Features />
  <PlanHighlight plan="pro" />
  <PlanHighlight plan="premium" />
  <ProductPreview />
  <HowItWorks />
  <Security />
  <Customization />
  <Pricing />
  <WhyCopermiq />
  <Footer />
</Layout>
